{
  "description": "Winston guard hooks: production-deploy gate, credential-console grant, session titles, update notice, starting branch, worktree setup, a setup reminder, open browser tabs, Winston parallelism check. Each hook reads the calling CLI (Claude Code or Codex) from its payload. After them, chattr (bundled): session enrollment, peer message delivery, wakes, and the shared-checkout guard; these stand down while a separate chattr plugin or the old install.sh hooks are present.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/start-branch.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking the starting branch"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-setup.mjs\"",
            "timeout": 30,
            "statusMessage": "Setting up the worktree"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-title.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/update-check.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for a newer Winston"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/doctor-nudge.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/chattr/chattr.mjs\" hook SessionStart --bundled",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "CHATTR_BIN=\"${CLAUDE_PLUGIN_ROOT}/chattr/chattr.mjs\" node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/chattr/hooks/worktree-session-start.mjs\" --bundled",
            "timeout": 10,
            "statusMessage": "Checking for another session in this directory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-title.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking the session title"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/secret-grant.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking for a secret-handling grant"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/deploy-gate.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking for a production-deploy approval"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/chattr/chattr.mjs\" hook UserPromptSubmit --bundled",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|shell|local_shell|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/deploy-gate.mjs\"",
            "timeout": 20,
            "statusMessage": "Checking production-deploy approval"
          }
        ]
      },
      {
        "matcher": "^mcp__claude-in-chrome__(navigate|browser_batch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/secret-grant.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking secret-handling authorization"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|NotebookEdit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "CHATTR_BIN=\"${CLAUDE_PLUGIN_ROOT}/chattr/chattr.mjs\" node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/chattr/hooks/worktree-guard.mjs\" --bundled || echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Blocked: the Winston shared-checkout check could not run, so it cannot rule out another session editing this folder. Move to a worktree (the EnterWorktree tool), start the session with CLAUDE_ALLOW_SHARED_CWD=1 to share deliberately, or run winston doctor.\"}}'",
            "timeout": 10,
            "statusMessage": "Checking for other sessions in this directory"
          }
        ]
      },
      {
        "matcher": "^(AskUserQuestion|request_user_input(_async)?)$",
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/chattr/chattr.mjs\" hook PreToolUse --bundled",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^EnterWorktree$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-setup.mjs\"",
            "timeout": 30,
            "statusMessage": "Setting up the new worktree"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/chattr/chattr.mjs\" hook PostToolUse --bundled",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/browser-tab-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for open browser tabs"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/parallelism-check.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/chattr/chattr.mjs\" hook Stop --bundled",
            "timeout": 20,
            "statusMessage": "chattr: message delivery"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/chattr/chattr.mjs\" hook PermissionRequest --bundled",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/chattr/chattr.mjs\" hook StopFailure --bundled",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/chattr/chattr.mjs\" hook Notification --bundled",
            "timeout": 10
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"${CLAUDE_PLUGIN_ROOT}/chattr/chattr.mjs\" hook Interrupt --bundled",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
