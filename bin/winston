#!/usr/bin/env node
/**
 * winston — the plugin's CLI. On the Bash tool's PATH through the plugin's bin/.
 *
 *   winston config [--json]            merged config, and which layers loaded
 *   winston doctor [--copy]            the setup checklist, ending in one "Next step:" line;
 *                                      changes nothing. --copy puts that step's command on
 *                                      the clipboard (macOS)
 *   winston init                       ask which setup this repository needs; changes nothing
 *   winston init --mode <join|new|adopt> [--yes]
 *                                      plan that setup; apply it only with --yes
 *       join    the repo is already set up for Winston: check this person's access, change
 *               nothing in the repo or on GitHub
 *       new     a new project: create the GitHub repo, both branches, the board, the config
 *       adopt   an existing repo Winston did not set up: fit a config to its branches,
 *               board and docs, and add only what is missing
 *       options: --board <owner>/<number>|new  --integration <branch>  --owner <name>
 *                --repo <owner>/<name>  --public
 *                --triage <keep|replace|both>   when another workflow already triages new
 *                issues: keep it, replace it with Winston's, or keep both knowingly
 *   winston permissions                list the Claude Code allow rules Winston runs use here,
 *                                      and which the project's .claude/settings.json lacks
 *   winston permissions --apply [--add <rule>]...
 *                                      add the missing ones to that file's permissions.allow
 *   winston install-codex-agents [--force]
 *   winston title <words...>           record this session's title (published on the next prompt)
 *
 * Doctor and init share one list of checks. A check init can fix carries a `fix`; one
 * that only a person can fix (GitHub has no API for it, or it needs access someone else
 * grants) carries `hand`, the steps. `scope: 'you'` marks what belongs to the person at
 * the keyboard rather than to the repo's setup.
 *
 * The triage workflow's two secrets are the owner's to create. Winston checks their names
 * only (`gh secret list` returns no values) and prints the steps; it never reads, prints,
 * generates or sets a secret's value.
 */

import { spawnSync } from 'node:child_process'
import { chmodSync, copyFileSync, existsSync, lstatSync, mkdirSync, readdirSync, readFileSync, realpathSync, renameSync, rmSync, statSync, writeFileSync } from 'node:fs'
import { homedir } from 'node:os'
import { basename, dirname, isAbsolute, join, relative, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import { doctorResultPath, loadLayers, repoRoot, winstonHome } from '../lib/config.mjs'
import { recordTitle } from '../hooks/session-title.mjs'
import { installedVersion, installScope, newer, updateSteps } from '../lib/update.mjs'

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..')

/**
 * The labels the triage engine writes, in any repo. A repo adds its own through
 * config `triage.labels` (names, or { name, color, description }).
 *   risk: <tier>    the record that triage ran; every triaged issue gets exactly one
 *   auto-merge      the work may be built and merged without a further ask
 *   auto-verify     verification an agent can run itself
 *   human-verify    verification only a person can do
 */
export const REQUIRED_LABELS = [
  { name: 'risk: low', color: '0e8a16', description: 'Triage: docs, copy, or an isolated fix' },
  { name: 'risk: medium', color: 'fbca04', description: 'Triage: a logic change, or several files' },
  { name: 'risk: high', color: 'b60205', description: 'Triage: high blast radius, or needs an owner decision' },
  { name: 'auto-merge', color: '1d76db', description: 'Triage: may be built and merged without a further ask' },
  { name: 'auto-verify', color: '5319e7', description: 'Triage: an agent can run the verification' },
  { name: 'human-verify', color: 'd93f0b', description: 'Triage: verification needs a person' },
]

const DEFAULT_STATUSES = ['New', 'Ready', 'Verify', 'Verified']
// The board Winston builds: six columns in this order, with these colours and
// descriptions. Four are the Winston roles, named by config `board.statuses`; In Progress
// and Done are GitHub's own, which the board's closing workflows point at.
const COLUMNS = [
  { role: 0, name: 'New', color: 'BLUE', description: 'Issues That Need To Be Evaluated' },
  { role: 1, name: 'Ready', color: 'GREEN', description: 'Triaged by a human. Ready to code.' },
  { name: 'In Progress', color: 'YELLOW', description: 'This is actively being worked on' },
  { role: 2, name: 'Verify', color: 'RED', description: 'Deployed to staging and ready for verification.' },
  { role: 3, name: 'Verified', color: 'GRAY', description: 'Confirmed on staging, ready to push to prod.' },
  { name: 'Done', color: 'PURPLE', description: 'This has been completed and pushed to prod' },
]
const columns = (statuses = DEFAULT_STATUSES) => COLUMNS.map(({ role, ...c }) => ({ ...c, name: role === undefined ? c.name : statuses[role] ?? c.name }))
// What a card on the kanban view shows, in order; a field the board lacks is skipped.
const CARD_FIELDS = ['Title', 'Assignees', 'Status', 'Labels', 'Linked pull requests', 'Sub-issues progress', 'Start date', 'Target date']
const DATE_FIELDS = ['Start date', 'Target date']
const PRIORITIES = ['P0', 'P1', 'P2', 'P3']
const TRIAGE_SECRETS = ['GH_PAT', 'CLAUDE_CODE_OAUTH_TOKEN']
const INTEGRATION_NAMES = ['staging', 'develop', 'dev', 'development']
const PROCESS_DOCS = ['AGENTS.md', 'CLAUDE.md', 'CONTRIBUTING.md']
const MODES = ['join', 'new', 'adopt']
// The owner's answer when another workflow already triages new issues.
const TRIAGE_CHOICES = ['keep', 'replace', 'both']
// A first push of a repo with history outlasts the default 30 seconds.
const PUSH_TIMEOUT = 600000
const DEFAULT_TRIAGE_WORKFLOW = 'triage-on-new-issue.yml'
const DEFAULT_MILESTONE = 'Phase 1.0'
// Sets the current phase's milestone on a new issue (config `phase`).
const PHASE_WORKFLOW = 'set-issue-phase.yml'
const DEFAULT_POLICY = 'TRIAGE.md'
/** Where every stop on a missing prerequisite sends the reader. */
export const DOCTOR_POINTER = 'Run /winston:doctor to see what is missing and how to fix it.'
/** The generic rows of the starter policy's risk tiers; a policy still carrying one has not been fitted to its repo. */
const STARTER_TIER = /is docs, copy or tooling only — nothing a user runs behaves differently/
const FAILED_RUNS = ['failure', 'timed_out', 'startup_failure']
const TRIAGE_RUNS = 5

function run(cmd, args, opts = {}) {
  const r = spawnSync(cmd, args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: 30000, ...opts })
  return { ok: r.status === 0, out: (r.stdout || '').trim(), err: (r.stderr || r.error?.message || '').trim() }
}

const onPath = (bin) => run('sh', ['-c', `command -v "$1"`, 'sh', bin]).ok

export function requiredLabels(config) {
  const extra = (config.triage?.labels ?? []).map((l) => (typeof l === 'string' ? { name: l } : l))
  const byName = new Map([...REQUIRED_LABELS, ...extra].map((l) => [l.name, l]))
  return [...byName.values()]
}

const codexHome = () => process.env.CODEX_HOME || join(homedir(), '.codex')
const codexSources = () => {
  const dir = join(ROOT, 'codex', 'agents')
  try {
    return readdirSync(dir).filter((f) => f.endsWith('.toml')).map((f) => ({ name: f, src: join(dir, f), dst: join(codexHome(), 'agents', f) }))
  } catch {
    return []
  }
}

const BOARD_QUERY = `query($owner:String!,$number:Int!){ repositoryOwner(login:$owner){
  ... on Organization{ projectV2(number:$number){ ...F } } ... on User{ projectV2(number:$number){ ...F } } } }
fragment F on ProjectV2 { id title fields(first:100){ nodes{ ... on ProjectV2FieldCommon{ id name } ... on ProjectV2SingleSelectField{ options{ id name color description } } } }
  workflows(first:50){ nodes{ name enabled } }
  views(first:50){ nodes{ id name layout filter fields(first:50){ nodes{ ... on ProjectV2FieldCommon{ id name } } }
    groupByFields(first:10){ nodes{ ... on ProjectV2FieldCommon{ name } } } verticalGroupByFields(first:10){ nodes{ ... on ProjectV2FieldCommon{ name } } } } } }`

const CREATE_VIEW_MUTATION = `mutation($projectId:ID!,$name:String!){ createProjectV2View(input:{projectId:$projectId,name:$name,layout:BOARD_LAYOUT}){ projectV2View{ id } } }`

/** A board view's columns are its vertical grouping; older data carries it as groupByFields. */
const isKanban = (v) => v?.layout === 'BOARD_LAYOUT' && [...(v.verticalGroupByFields?.nodes ?? []), ...(v.groupByFields?.nodes ?? [])].some((f) => f?.name === 'Status')

/** Set which fields a view's cards show, and optionally its filter. */
function updateView(viewId, fieldIds, filter) {
  const input = `viewId:$viewId,configuration:{visibleFieldIds:${JSON.stringify(fieldIds)}}${filter === undefined ? '' : `,filter:${JSON.stringify(filter)}`}`
  const r = run('gh', ['api', 'graphql', '-f', `query=mutation($viewId:ID!){ updateProjectV2View(input:{${input}}){ projectV2View{ id } } }`, '-f', `viewId=${viewId}`])
  if (!r.ok) throw new Error(`update view: ${r.err || r.out}`)
}

const LINKED_BOARDS_QUERY = `query($owner:String!,$name:String!){ repository(owner:$owner,name:$name){ projectsV2(first:50){ nodes{ number title closed
  owner{ ... on Organization{ login } ... on User{ login } } } } } }`

function fetchBoard(owner, number) {
  const r = run('gh', ['api', 'graphql', '-f', `query=${BOARD_QUERY}`, '-f', `owner=${owner}`, '-F', `number=${number}`])
  try {
    return { project: JSON.parse(r.out).data.repositoryOwner.projectV2, err: r.err }
  } catch {
    return { project: null, err: r.err }
  }
}

/** The board's web address; an organization's and a user's differ. */
function boardUrl(owner, number) {
  const kind = run('gh', ['api', `users/${owner}`, '--jq', '.type']).out === 'Organization' ? 'orgs' : 'users'
  return `https://github.com/${kind}/${owner}/projects/${number}`
}

/**
 * Set a single-select field's options. An option passed with its `id` is kept, items
 * and all; one left out is deleted. So adding means passing every existing option too.
 */
function setOptions(fieldId, options) {
  const lit = options.map((o) => `{${o.id ? `id:${JSON.stringify(o.id)},` : ''}name:${JSON.stringify(o.name)},color:${o.color || 'GRAY'},description:${JSON.stringify(o.description || '')}}`).join(',')
  const r = run('gh', ['api', 'graphql', '-f', `query=mutation($fieldId:ID!){ updateProjectV2Field(input:{fieldId:$fieldId,singleSelectOptions:[${lit}]}){ projectV2Field{ ... on ProjectV2SingleSelectField{ id } } } }`, '-f', `fieldId=${fieldId}`])
  if (!r.ok) throw new Error(`set field options: ${r.err || r.out}`)
}

function createDateField(owner, number, name) {
  const r = run('gh', ['project', 'field-create', String(number), '--owner', owner, '--name', name, '--data-type', 'DATE'])
  if (!r.ok) throw new Error(`create the ${name} field: ${r.err}`)
}

function createPriorityField(owner, number, name) {
  const r = run('gh', ['project', 'field-create', String(number), '--owner', owner, '--name', name, '--data-type', 'SINGLE_SELECT', '--single-select-options', PRIORITIES.join(',')])
  if (!r.ok) throw new Error(`create the ${name} field: ${r.err}`)
}

const openMilestones = (root) => run('gh', ['api', '--method', 'GET', 'repos/{owner}/{repo}/milestones', '-f', 'state=open', '--jq', '.[].title'], { cwd: root }).out.split('\n').filter(Boolean)

// The projects automation's login as GraphQL gives it (REST adds "[bot]").
const INTAKE_BOT = 'github-project-automation'
const INTAKE_QUERY = `query($owner:String!,$name:String!){ repository(owner:$owner,name:$name){ issues(last:5){ nodes{ number
  timelineItems(first:100,itemTypes:[ADDED_TO_PROJECT_V2_EVENT,PROJECT_V2_ITEM_STATUS_CHANGED_EVENT]){ nodes{ __typename
    ... on AddedToProjectV2Event{ actor{ login } project{ number owner{ ... on User{ login } ... on Organization{ login } } } }
    ... on ProjectV2ItemStatusChangedEvent{ actor{ login } project{ number owner{ ... on User{ login } ... on Organization{ login } } } } } } } } } }`

/**
 * Whether this board's two intake workflows have actually run recently, read from the
 * repo's five most recent issues: an "added to project" or "status changed" event made by
 * the projects automation ON THIS BOARD. The board is what makes it evidence. An issue
 * timeline also carries the events of every other project that took the issue, and of a
 * person or agent adding it by hand, and neither says anything about this board (#45: an
 * older project was auto-adding the repo's issues while this board's workflows were off).
 * A second source beside the `ProjectV2.workflows` listing. `checked` is false when the
 * repo has no issues to read.
 */
function intakeFromTimeline(root, owner, number) {
  const r = run('gh', ['api', 'graphql', '-f', `query=${INTAKE_QUERY}`, '-F', 'owner={owner}', '-F', 'name={repo}'], { cwd: root })
  let issues = []
  try {
    issues = JSON.parse(r.out).data.repository.issues.nodes.filter(Boolean)
  } catch {}
  const result = { checked: issues.length > 0, addedToProject: null, statusChanged: null }
  const here = (e) => e?.actor?.login?.startsWith(INTAKE_BOT) && e.project?.number === number && e.project?.owner?.login?.toLowerCase() === String(owner).toLowerCase()
  // Newest first, so the detail names the most recent proof.
  for (const issue of [...issues].sort((a, b) => b.number - a.number)) {
    for (const e of (issue.timelineItems?.nodes ?? []).filter(here)) {
      if (e.__typename === 'AddedToProjectV2Event') result.addedToProject ??= issue.number
      if (e.__typename === 'ProjectV2ItemStatusChangedEvent') result.statusChanged ??= issue.number
    }
  }
  return result
}

function createMilestone(root, title) {
  const r = run('gh', ['api', 'repos/{owner}/{repo}/milestones', '-f', `title=${title}`], { cwd: root })
  if (!r.ok) throw new Error(`create milestone ${title}: ${r.err}`)
}

function createKanbanView(root, project) {
  const milestone = openMilestones(root)[0] ?? (createMilestone(root, DEFAULT_MILESTONE), DEFAULT_MILESTONE)
  const created = run('gh', ['api', 'graphql', '-f', `query=${CREATE_VIEW_MUTATION}`, '-f', `projectId=${project.id}`, '-f', `name=${milestone}`])
  let viewId
  try {
    viewId = JSON.parse(created.out).data.createProjectV2View.projectV2View.id
  } catch {
    throw new Error(`create view: ${created.err || created.out}`)
  }
  const ids = new Map(project.fields.nodes.filter((f) => f?.name).map((f) => [f.name, f.id]))
  updateView(viewId, CARD_FIELDS.map((n) => ids.get(n)).filter(Boolean), `milestone:"${milestone}"`)
}

/** Create `branch` on origin at the tip of origin's `from`, without touching the checkout. */
function createBranch(root, branch, from) {
  const must = (r, what) => { if (!r.ok) throw new Error(`${what}: ${r.err || r.out}`) }
  must(run('git', ['-C', root, 'fetch', '-q', 'origin', from], { timeout: PUSH_TIMEOUT }), `git fetch origin ${from}`)
  must(run('git', ['-C', root, 'push', '-q', 'origin', `FETCH_HEAD:refs/heads/${branch}`], { timeout: PUSH_TIMEOUT }), `git push origin ${branch}`)
}

/** What each config value the starter policy uses is, in words, for a value the config lacks. */
const POLICY_VALUES = {
  owner: 'the name of the person who approves and decides',
  'board.owner': 'the GitHub user or organization that owns the board',
  'board.number': 'the board\'s project number',
  'board.statuses[0]': 'the status new issues arrive in',
  'board.statuses[1]': 'the status that means ready to work',
  'board.priorityField': 'the name of the board\'s priority field',
  'branches.integration': 'the branch work lands on',
  'branches.production': 'the branch that is released',
}
const FILL_IN = 'fill this in: '

/**
 * Write the starter policy, never over an existing file. Each `{{key}}` becomes the
 * config's value for it (`{{board.statuses[0]}}`, `{{owner}}`). Where the config has no
 * such value the text says "fill this in: <what>" in plain words, never a placeholder.
 * The template's opening comment, which tells a person to do that substitution by hand,
 * is replaced. The (per-repo) sections stay generic.
 */
function writeStarterPolicy(file, config) {
  const filled = { ...config, board: { statuses: DEFAULT_STATUSES, priorityField: 'Priority', ...config.board } }
  const text = readFileSync(join(ROOT, 'templates', 'TRIAGE.md'), 'utf8')
    .replace(/^<!--[^]*?-->\n/, '<!-- Winston starter triage policy, written by winston init. Rewrite the three sections\nmarked (per-repo) at the end for this repository, then delete this comment. -->\n')
    .replace(/\{\{([\w.[\]]+)\}\}/g, (whole, key) => {
      const value = key.split(/[.[\]]+/).filter(Boolean).reduce((v, k) => (v && Object.hasOwn(v, k) ? v[k] : undefined), filled)
      return typeof value === 'string' || typeof value === 'number' ? String(value) : `${FILL_IN}${POLICY_VALUES[key] ?? `the value of ${key}`}`
    })
  writeFileSync(file, text, { flag: 'wx' })
}

/** The lines of a policy still waiting for a value: a `{{placeholder}}` or a "fill this in". */
export function policyBlanks(file) {
  let text
  try {
    text = readFileSync(file, 'utf8')
  } catch {
    return []
  }
  return text.split('\n').flatMap((line, i) => (/\{\{[^}]*\}\}/.test(line) || line.includes(FILL_IN) ? [`line ${i + 1}: ${line.trim().slice(0, 140)}`] : []))
}

/** The open issues that have no milestone, by number; null when gh cannot list them. */
function issuesWithoutMilestone(root) {
  const r = run('gh', ['issue', 'list', '--state', 'open', '--limit', '500', '--json', 'number,milestone', '--jq', '.[] | select(.milestone == null) | .number'], { cwd: root })
  return r.ok ? r.out.split('\n').filter(Boolean) : null
}

function writeTriageWorkflow(wf) {
  mkdirSync(dirname(wf), { recursive: true })
  copyFileSync(join(ROOT, 'templates', 'triage-on-new-issue.yml'), wf)
}

/**
 * True when a workflow runs on a newly opened issue: its `on:` names `issues`, with no
 * `types` (the default includes opened) or with `opened` among them. Read line by line,
 * with no YAML parser: enough for the forms GitHub documents, and a file it cannot read
 * this way counts as not firing.
 */
export function firesOnNewIssue(text) {
  const lines = text.split('\n').map((l) => l.replace(/(^|\s)#.*$/, '').trimEnd())
  const at = lines.findIndex((l) => /^(on|'on'|"on")\s*:/.test(l))
  if (at === -1) return false
  const inline = lines[at].slice(lines[at].indexOf(':') + 1).trim()
  if (inline) {
    // `on: issues`, `on: [push, issues]`, or a flow map, where only the issues entry's own types count.
    const m = /(?:^|[\s[,{'"])issues['"]?\s*(?::\s*(\{[^}]*\}))?(?=$|[\s\],:}'"])/.exec(inline)
    if (!m) return false
    return !m[1] || !/types/.test(m[1]) || /\bopened\b/.test(m[1])
  }
  const indent = (l) => l.length - l.trimStart().length
  // The block under on: runs to the next top-level key; a sequence may sit at column 0.
  const block = []
  for (const l of lines.slice(at + 1)) {
    if (l && indent(l) === 0 && !l.startsWith('-')) break
    if (l) block.push(l)
  }
  if (!block.length) return false
  // Only the events themselves, on:'s direct children: not a key or item nested under one.
  const level = indent(block[0])
  const direct = block.map((l, i) => ({ l, i })).filter(({ l }) => indent(l) === level)
  if (direct.some(({ l }) => /^\s*-\s*['"]?issues['"]?\s*$/.test(l))) return true
  const hit = direct.find(({ l }) => /^\s*['"]?issues['"]?\s*:/.test(l))
  if (!hit) return false
  const own = [hit.l.slice(hit.l.indexOf(':') + 1)]
  for (const l of block.slice(hit.i + 1)) {
    if (indent(l) <= level) break
    own.push(l)
  }
  const body = own.join('\n')
  return !/types\s*:/.test(body) || /\bopened\b/.test(body.slice(body.search(/types\s*:/)))
}

/**
 * Other workflows in the repo that also triage a new issue: they run when one is opened,
 * and either write a `risk:` tier or are named for triage (the file, or its `name:`). A
 * workflow that greets a new issue, stamps it, or adds a "needs-triage" label is not one.
 */
function otherTriageWorkflows(root, wfName) {
  const dir = join(root, '.github', 'workflows')
  let names
  try {
    names = readdirSync(dir)
  } catch {
    return []
  }
  return names.filter((n) => /\.ya?ml$/.test(n) && n !== wfName && n !== PHASE_WORKFLOW).sort().filter((n) => {
    try {
      const text = readFileSync(join(dir, n), 'utf8')
      const named = /triage/i.test(n) || /^name\s*:.*triage/im.test(text)
      return firesOnNewIssue(text) && (named || /risk:\s*(low|medium|high)/i.test(text))
    } catch {
      return false
    }
  })
}

/** Merge keys into the repo config's `triage` section, leaving the rest of the file as it is. */
function patchTriage(configPath, patch) {
  const data = JSON.parse(readFileSync(configPath, 'utf8'))
  writeFileSync(configPath, JSON.stringify({ ...data, triage: { ...data.triage, ...patch } }, null, 2) + '\n')
}

/**
 * The Claude Code rules a Winston run uses in this repo, as { allow, deny }.
 *
 * allow: the git and gh forms the skills call, each as narrow as a pattern can make it
 * and scoped by the config where it can be, then the repo's own (config
 * `permissions.allow`) and any passed with --add. Merging pull requests is listed only
 * where the deploy-gate hook guards merges, so the rule cannot wave a production merge
 * through.
 *
 * deny: an allow pattern cannot exclude a flag, so `git push origin *` would also cover a
 * force push, a push to production and a branch deletion. Claude Code checks deny before
 * allow, so the short deny list is what keeps those out: deny wins.
 */
export function permissionRules(config, extra = []) {
  const { integration, production } = config.branches ?? {}
  const board = config.board?.number
  const gated = (config.deployGate?.guarded ?? []).some((g) => g?.kind === 'pr-merge')
  const allow = [
    'git status*', 'git diff*', 'git log*', 'git show*', 'git fetch*',
    'git branch --show-current*', 'git branch --list*', 'git worktree list*', 'git worktree add *',
    'git switch -c *', ...(integration ? [`git switch ${integration}`, `git rebase origin/${integration}*`] : []),
    'git add *', 'git commit -m *', 'git commit -F *', 'git push origin *', 'git push -u origin *',
    'gh issue view*', 'gh issue list*', 'gh pr view*', 'gh pr list*', 'gh pr checks*', 'gh pr diff*', 'gh run view*', 'gh run list*', 'gh label list*',
    ...(Number.isInteger(board) ? [`gh project item-list ${board}*`] : []),
    'gh pr create *', 'gh pr comment *', 'gh pr review * --comment*', 'gh pr edit * --add-label *', 'gh pr edit * --remove-label *',
    ...(gated ? ['gh pr merge *'] : []),
    'gh issue comment *', 'gh issue edit * --add-label *', 'gh issue edit * --remove-label *', 'gh project item-edit *',
    'winston config*', 'winston doctor*', 'winston title *',
  ]
  const deny = [
    // No `git push* :*` for the colon form of a deletion: a trailing `:*` is Claude Code's
    // prefix syntax, so that rule would deny every push.
    // `--force*` takes --force-with-lease with it, and a refspec that starts with + is a
    // force push too. The production branch is named in each form a push can give it, as
    // a whole word, so a branch that merely starts with its name is left alone.
    'git push*--force*', 'git push* -f*', 'git push* +*', 'git push*--delete*', 'git push*--all*', 'git push*--mirror*',
    ...(production ? ['', ':', ' refs/heads/', ':refs/heads/'].flatMap((form) => {
      const ref = form === '' ? ` ${production}` : `${form}${production}`
      return [`git push*${ref}`, `git push*${ref} *`]
    }) : []),
    'gh pr review*--approve*', 'gh pr review* -a*',
    'git branch* -D*', 'git branch*--force*', 'git worktree remove*--force*', 'git worktree remove* -f*',
  ]
  const own = [...(Array.isArray(config.permissions?.allow) ? config.permissions.allow : []), ...extra].filter((r) => typeof r === 'string')
  return { allow: [...new Set([...allow.map((c) => `Bash(${c})`), ...own])], deny: deny.map((c) => `Bash(${c})`) }
}

// A tool name may carry hyphens: mcp__claude-in-chrome__navigate.
const RULE = /^([\w-]+)(?:\((.+)\))?$/s

const ruleText = (spec = '') => spec.replace(/ ?:?\*$/, '').trim()

/** A rule that allows a whole tool, or every command of one: never added. */
const tooWide = (rule) => /^Bash(\([\s:*]*\))?$/.test(rule)

/**
 * The entry of `list` that covers all of what `rule` names, or null: the same rule, the
 * bare tool, or a pattern that matches the command `rule` starts with. Used against deny
 * (a rule a deny entry covers is never added; a narrower deny is no conflict, since deny
 * is evaluated first), against ask, and against allow (a rule already covered is not
 * added twice).
 */
export function coveredBy(rule, list) {
  if (list.includes(rule)) return rule
  const m = RULE.exec(rule)
  if (!m) return null
  const text = ruleText(m[2])
  return list.find((d) => {
    if (d === m[1]) return true
    const dm = RULE.exec(d)
    if (!dm?.[2] || dm[1] !== m[1]) return false
    // As Claude Code reads a pattern: `*` is any text, and a trailing ` *` is a word
    // boundary (the bare command, or the command and its arguments), so `main *` does not
    // take `maintenance`. A trailing `:*` is the older prefix form.
    const spaced = / \*$/.test(dm[2])
    const body = dm[2].replace(spaced ? / \*$/ : /:\*$/, spaced ? '' : '*')
    const pattern = body.split('*').map((part) => part.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('.*')
    return new RegExp(`^${pattern}${spaced ? '( .*)?' : ''}$`, 's').test(text)
  }) ?? null
}

/** An allow entry that is a narrower form of the same command: the owner's choice, left alone. */
function narrowerIn(rule, allow) {
  const m = RULE.exec(rule)
  const text = m && ruleText(m[2])
  if (!text) return null
  return allow.find((a) => {
    const am = RULE.exec(a)
    return am?.[1] === m[1] && am[2]?.startsWith(text) && /^([ :*]|$)/.test(am[2].slice(text.length))
  }) ?? null
}

/**
 * The project's .claude/settings.json and each expected rule's state in it. An allow rule
 * is have, missing, denied, asks or narrower; a deny rule is have or missing. Throws,
 * having changed nothing, when the file is not the JSON Claude Code reads, is a link that
 * leads out of the repository, or a rule from the config or --add is too wide to add.
 */
function permissionState(root, config, extra = []) {
  let path = join(root, '.claude', 'settings.json')
  // The project's own file only. A link that stays inside the repository is followed to
  // the real file; one that leads out is refused.
  for (const p of [dirname(path), path]) {
    if (!lstatSync(p, { throwIfNoEntry: false })?.isSymbolicLink()) continue
    let inside = false
    try {
      inside = !relative(realpathSync(root), realpathSync(p)).startsWith('..')
    } catch {}
    if (!inside) throw new Error(`${p} is a link that leads outside the repository. Nothing was changed.`)
  }
  if (existsSync(path)) path = realpathSync(path)
  const text = existsSync(path) ? readFileSync(path, 'utf8') : null
  const isObject = (v) => !!v && typeof v === 'object' && !Array.isArray(v)
  let data = {}
  if (text !== null) {
    try {
      data = JSON.parse(text)
    } catch (e) {
      throw new Error(`${path} is not valid JSON (${e.message}). Nothing was changed: fix the file, then rerun.`)
    }
  }
  const lists = isObject(data) && (data.permissions === undefined || (isObject(data.permissions) && ['allow', 'deny', 'ask'].every((k) => data.permissions[k] === undefined || Array.isArray(data.permissions[k]))))
  if (!lists) throw new Error(`${path} is not a settings object whose permissions.allow, deny and ask are lists. Nothing was changed: fix the file, then rerun.`)
  const wanted = permissionRules(config, extra)
  const wide = wanted.allow.find(tooWide)
  if (wide) throw new Error(`${wide} would allow every shell command, so Winston does not add it (it came from config permissions.allow or --add). Nothing was changed: name the commands instead, such as Bash(npm test*).`)
  const strings = (k) => (data.permissions?.[k] ?? []).filter((r) => typeof r === 'string')
  const [allow, deny, ask] = [strings('allow'), strings('deny'), strings('ask')]
  const rules = wanted.allow.map((rule) => {
    if (coveredBy(rule, allow)) return { rule, state: 'have' }
    const by = coveredBy(rule, deny)
    if (by) return { rule, state: 'denied', note: `not added: the deny rule ${by} covers it` }
    const asks = coveredBy(rule, ask)
    if (asks) return { rule, state: 'asks', note: `not added: the ask rule ${asks} covers it, so it still prompts` }
    const narrower = narrowerIn(rule, allow)
    return narrower ? { rule, state: 'narrower', note: `not added: the project allows a narrower form, ${narrower}` } : { rule, state: 'missing' }
  })
  const denies = wanted.deny.map((rule) => ({ rule, deny: true, state: coveredBy(rule, deny) ? 'have' : 'missing' }))
  return { path, text, data, rules, denies }
}

const NO_FORCE = 'The deny list blocks every force push, --force-with-lease included. To update a branch that is already pushed, merge its base branch into it and push normally; do not rebase it.'
const GATES = 'An allow rule only removes a prompt, and deny wins over allow: deny and ask rules, hooks, production approval and secret grants still apply.'

/**
 * List the rules, or with --apply add the missing ones to the project file. Only
 * permissions.allow and permissions.deny grow: existing rules in every list, every other
 * key, the file's indentation, mode and final newline are kept, and no deny or ask entry
 * is removed or loosened. User-level settings are never touched.
 */
function permissions(cwd, opts) {
  const root = repoRoot(cwd)
  if (!root) throw new Error(`winston permissions: ${cwd} is not inside a git repository\n${DOCTOR_POINTER}`)
  const bad = (opts.add ?? []).find((r) => !RULE.test(r))
  if (bad) throw new Error(`winston permissions: --add takes a Claude Code rule such as 'Bash(npm test*)', got: ${bad}`)
  const layers = loadLayers(cwd)
  const st = permissionState(root, { ...layers.user.data, ...layers.repo.data }, opts.add)
  const lacking = st.rules.filter((r) => r.state === 'missing')
  const denies = st.denies.filter((r) => r.state === 'missing')
  const skipped = st.rules.filter((r) => r.note)
  if (!opts.apply) {
    console.log(`Claude Code rules Winston runs use in this repo, against ${st.path}${st.text === null ? ' (not there yet)' : ''}.`)
    console.log('\nAllow (these stop prompting):')
    for (const r of st.rules) console.log(`  ${r.state.padEnd(8)} ${r.rule}${r.note ? `  — ${r.note}` : ''}`)
    console.log('\nDeny (an allow pattern cannot leave out a flag, so these keep force pushes, pushes to production, approvals and forced deletions blocked; deny wins over allow):')
    for (const r of st.denies) console.log(`  ${r.state.padEnd(8)} ${r.rule}`)
    console.log(`\n${NO_FORCE}`)
    console.log(lacking.length || denies.length ? `\nAdd the ${lacking.length} missing allow and ${denies.length} missing deny rules to the project's settings: winston permissions --apply` : '\nNothing is missing.')
    console.log(GATES)
    return 0
  }
  for (const r of skipped) console.log(`${r.state.padEnd(8)} ${r.rule}  — ${r.note}`)
  if (!lacking.length && !denies.length) {
    console.log(`Nothing to add: ${st.path} has every rule.`)
    return 0
  }
  const had = st.data.permissions ?? {}
  const data = {
    ...st.data,
    permissions: {
      ...had,
      ...(lacking.length || had.allow ? { allow: [...(had.allow ?? []), ...lacking.map((r) => r.rule)] } : {}),
      ...(denies.length || had.deny ? { deny: [...(had.deny ?? []), ...denies.map((r) => r.rule)] } : {}),
    },
  }
  const indent = st.text?.match(/^([ \t]+)\S/m)?.[1] ?? 2
  mkdirSync(dirname(st.path), { recursive: true })
  // Written beside the file and renamed over it, so a hard link to a file elsewhere is
  // replaced rather than written through. The file keeps its mode.
  const tmp = `${st.path}.winston-${process.pid}`
  try {
    writeFileSync(tmp, JSON.stringify(data, null, indent) + (st.text === null || st.text.endsWith('\n') ? '\n' : ''), { flag: 'wx' })
    if (st.text !== null) chmodSync(tmp, statSync(st.path).mode & 0o7777)
    renameSync(tmp, st.path)
  } catch (e) {
    rmSync(tmp, { force: true })
    throw new Error(`could not write ${st.path}: ${e.message}. Nothing was changed.`)
  }
  for (const r of lacking) console.log(`added    ${r.rule}`)
  if (denies.length) {
    console.log('\nAdded to permissions.deny, which wins over allow (no existing deny or ask rule was removed or loosened):')
    for (const r of denies) console.log(`denied   ${r.rule}`)
    // An allow entry the project already had that a new deny now covers: say so.
    const allowed = (had.allow ?? []).filter((a) => typeof a === 'string')
    const overridden = denies.flatMap((d) => allowed.filter((a) => coveredBy(a, [d.rule])).map((a) => `${d.rule} now overrides the existing allow rule ${a}`))
    if (overridden.length) {
      console.log('\nThese deny rules cover allow rules the project already had, so those actions are now blocked (remove the deny rule by hand if that is not what you want):')
      for (const line of overridden) console.log(`  ${line}`)
    }
    console.log(`\n${NO_FORCE}`)
  }
  console.log(`\n${lacking.length} allow and ${denies.length} deny ${lacking.length + denies.length === 1 ? 'rule' : 'rules'} added in ${st.path}. ${GATES}`)
  return 0
}

/**
 * Whether a file holds triage rules: 'missing' (no such file), 'empty' or 'ok'. The test
 * is deliberately simple. Rules are a markdown heading that names triage, or a risk tier
 * label (`risk: low`, `risk: medium` or `risk: high`). A doc with neither gives the triage
 * engine nothing to apply, and a pass under it runs clean and changes nothing.
 */
export function policyState(file) {
  let text
  try {
    text = readFileSync(file, 'utf8')
  } catch {
    return 'missing'
  }
  return /^#{1,6}\s.*\btriage\b/im.test(text) || /\brisk:\s*(low|medium|high)\b/i.test(text) ? 'ok' : 'empty'
}

/**
 * The owner's steps for the triage workflow's secrets, as lines. `want` is the names to
 * create. Which token GH_PAT is depends on who owns the board: GitHub's fine-grained tokens
 * cannot reach a project owned by a user account, and cover one owner at a time.
 */
/**
 * The page that creates GH_PAT, with the form filled in as far as GitHub lets a link fill
 * it. The fine-grained form's parameters are the ones GitHub documents: `name`,
 * `description`, `target_name`, `expires_in` and one per permission. The classic form's
 * `scopes=repo,project` is best effort: GitHub's token page documents no prefill for
 * it, so the printed directions always name both scopes to tick. A link carries no
 * secret: the token exists only after the owner clicks Generate.
 */
export function tokenUrl({ fineGrained, slug, boardOwner }) {
  if (!fineGrained) return `https://github.com/settings/tokens/new?scopes=${['repo', 'project'].map(encodeURIComponent).join(',')}`
  const params = new URLSearchParams({
    name: `winston triage ${slug.split('/')[1] ?? ''}`.trim().slice(0, 40),
    description: `Winston triage workflow for ${slug}: Issues on the repository and Projects on ${boardOwner}, read and write.`.slice(0, 1024),
    target_name: boardOwner,
    expires_in: '90',
    issues: 'write',
    organization_projects: 'write',
  })
  return `https://github.com/settings/personal-access-tokens/new?${params}`
}

function secretSteps({ slug, known, want, boardOwner, wfName }) {
  const flag = slug ? ` --repo ${slug}` : ''
  const where = slug || 'this repository'
  const repoOwner = slug?.split('/')[0]
  const board = boardOwner || 'the board\'s owner'
  const lines = [known
    ? `Not set on ${where}: ${want.join(', ')}. Until both secrets exist, new issues are not triaged automatically. (Only the repository's own secrets are checked: one set at organization level does not show here.)`
    : `This account cannot list the secrets of ${where}, so see which exist first: gh secret list${flag}. Then, for each of ${want.join(' and ')} it does not show:`]
  let n = 0
  const step = (text) => lines.push(`  ${++n}. ${text}`)
  if (want.includes('GH_PAT')) {
    lines.push(`GH_PAT, a token that can read and write Issues on ${where} and Projects on ${board}:`)
    const type = boardOwner ? run('gh', ['api', `users/${boardOwner}`, '--jq', '.type']).out : ''
    const fineGrained = type === 'Organization' && !!slug && repoOwner?.toLowerCase() === boardOwner.toLowerCase()
    const url = tokenUrl({ fineGrained, slug, boardOwner })
    lines.next = { open: url }
    const why = type === 'User' ? `${boardOwner} is a user account, and a fine-grained token cannot reach a user's projects, so this is a classic token`
      : type !== 'Organization' ? `gh could not tell whether ${board} is a user or an organization, so this is a classic token, which reaches the projects of either`
        : !fineGrained ? `the board is ${boardOwner}'s and the repository is not, and a fine-grained token covers one owner, so this is a classic token`
          : `${boardOwner} is an organization, so this is a fine-grained token`
    step(`Open this link while signed in to GitHub; it ${fineGrained ? 'fills in the form' : 'opens the form, and should tick the two scopes'} (${why}): ${url}`)
    if (fineGrained) {
      step(`Check the form: Token name (filled in), Resource owner ${boardOwner}, Expiration 90 days (change it if you like). Under Repository access choose "Only select repositories" and pick ${slug}; the link cannot fill that in. Under Permissions: Repository permissions "Issues: Read and write", Organization permissions "Projects: Read and write"`)
      step(`If the form came up empty: github.com, your picture, Settings, Developer settings, Personal access tokens, Fine-grained tokens, "Generate new token", and enter the values from the step above`)
      step(`Click "Generate token" yourself and copy the token; GitHub shows it once. If ${boardOwner} requires approval for fine-grained tokens, one of its owners approves it before it works`)
    } else {
      step('Check the form: Note is empty, so type a name such as "winston triage" (the link cannot fill it in). Expiration: your choice; 90 days is a reasonable one. Under Select scopes, "repo" and "project" must be ticked: tick them if the link did not, and nothing else needs to be')
      step('If the form came up empty: github.com, your picture, Settings, Developer settings, Personal access tokens, Tokens (classic), "Generate new token (classic)", then the Note, the Expiration, and tick "repo" and "project"')
      step('Click "Generate token" yourself and copy the token; GitHub shows it once')
    }
    step(`In your own terminal: gh secret set GH_PAT${flag}   (it prompts for the value: paste the token there, never into a chat)`)
  }
  if (want.includes('CLAUDE_CODE_OAUTH_TOKEN')) {
    lines.push('CLAUDE_CODE_OAUTH_TOKEN, which lets the workflow run Claude on your subscription:')
    lines.next ??= { command: 'claude setup-token' }
    step('In your own terminal: claude setup-token   (it opens a browser to sign in to Claude; approve there, and it prints a long-lived token; copy it)')
    step(`In your own terminal: gh secret set CLAUDE_CODE_OAUTH_TOKEN${flag}   (paste that token at the prompt)`)
  }
  lines.push('Then prove it, once the workflow is on the default branch:')
  step(`gh workflow run ${wfName}${flag} -f issue=<the number of an open issue>`)
  step(`gh run list --workflow ${wfName}${flag} --limit 1   (repeat until it shows completed and success)`)
  return lines
}

const ownerSteps = (list) => list.some((c) => c.steps || c.ownerStep || c.blanks)

/** The owner's step for a policy with values still to fill in. */
function printBlanks(file, lines) {
  if (!lines.length) return
  console.log(`\nValues to fill in (the owner's to do): ${file} has ${lines.length} ${lines.length === 1 ? 'line' : 'lines'} that say "fill this in", where the config had no value. Open the file and replace each with the real value:`)
  for (const line of lines) console.log(`  ${line}`)
}

/** The owner's steps init prints: the workflow's secrets, then the project's allow rules. */
function printOwnerSteps(list) {
  const secrets = list.find((c) => c.steps)
  if (secrets) {
    console.log('\nSecrets the triage workflow needs (the owner\'s to do, in a normal terminal; a token\'s value is never pasted into a chat):')
    for (const line of secrets.steps()) console.log(`  ${line}`)
  }
  const blanks = list.find((c) => c.blanks)
  if (blanks) printBlanks(blanks.blanks.file, blanks.blanks.lines)
  const rules = list.find((c) => c.ownerStep)
  if (rules) {
    console.log('\nPermission rules (the owner\'s to do, in one step):')
    for (const line of rules.ownerStep) console.log(`  ${line}`)
  }
}

/**
 * Every check, in report order: { name, state: ok|missing|on|off|unknown|failed, detail, required, fix?, hand?, scope? }.
 * `planned` is init's proposal for a repo with no config yet: { config, newBoard, noRepo, firstCommit, slug }.
 * The checks then describe the repo as it will be once init's first steps have run.
 * `forInit` checks the triage workflow's secrets even before the workflow file exists,
 * since init is about to write it. `choice` is the owner's answer (init --triage) to a
 * second workflow that triages new issues: keep, replace or both. A check with `conflict`
 * is that question, and carries a `fix` only once it is answered.
 * A check with `problem` is one doctor calls out; one
 * with `steps` carries the owner's steps for the secrets, one with `ownerStep` the one for
 * the project's permission rules.
 */
export function checks(cwd, planned = null, forInit = false, choice = null) {
  const out = []
  const add = (c) => out.push({ required: true, detail: '', ...c })

  add({ name: 'claude on PATH', state: onPath('claude') ? 'ok' : 'missing', scope: 'you', hand: 'install Claude Code, or put `claude` on PATH' })

  const auth = run('gh', ['auth', 'status', '--json', 'hosts', '--jq', '.hosts["github.com"][] | select(.active) | .scopes'])
  const scopes = auth.out.split(/,\s*/)
  add({
    name: 'gh auth with project scope',
    state: auth.ok && scopes.includes('project') ? 'ok' : 'missing',
    detail: !auth.ok ? 'gh not installed or not logged in' : scopes.includes('project') ? '' : 'run: gh auth refresh -s project',
    scope: 'you', hand: !auth.ok ? 'run: gh auth login, then: gh auth refresh -s project' : 'run: gh auth refresh -s project',
    command: !auth.ok ? 'gh auth login' : 'gh auth refresh -s project',
    fixLines: !auth.ok ? ['First: gh auth login   (it opens a browser to sign in to GitHub)', 'Then: gh auth refresh -s project   (lets gh read and update the board)'] : ['gh auth refresh -s project   (lets gh read and update the board)'],
  })

  let layers
  try {
    layers = loadLayers(cwd)
  } catch (e) {
    add({ name: 'repo config', state: 'missing', detail: e.message })
    return out
  }
  const { repo } = layers
  const root = layers.root ?? (planned ? cwd : null)
  if (!root) {
    add({ name: 'git repository', state: 'missing', detail: `${cwd} is not inside a git repository`, unconfigured: true })
    return out
  }
  const config = planned ? { ...layers.user.data, ...planned.config } : { ...layers.user.data, ...repo.data }
  const configPath = join(root, '.winston', 'config.json')
  if (planned) {
    // init's first steps write the config and settle the branches.
  } else if (!repo.loaded) {
    add({ name: 'repo config', state: 'missing', detail: `${configPath} not found`, unconfigured: true })
  } else {
    const problems = []
    if (!config.branches?.integration || !config.branches?.production) problems.push('branches.integration and branches.production')
    if (!config.board?.owner || !Number.isInteger(config.board?.number)) problems.push('board.owner and board.number')
    add({ name: 'repo config', state: problems.length ? 'missing' : 'ok', detail: problems.length ? `needs ${problems.join(', ')}` : configPath })
  }

  const branchOn = (branch) => run('git', ['-C', root, 'ls-remote', '--exit-code', '--heads', 'origin', branch]).ok
  for (const role of planned ? [] : ['integration', 'production']) {
    const branch = config.branches?.[role]
    if (!branch) continue
    const there = branchOn(branch)
    const from = config.branches?.production
    add({
      name: `${role} branch on origin`, state: there ? 'ok' : 'missing', detail: branch,
      // The integration branch is Winston's to make, from production. A missing production
      // branch means the config names the wrong one, which only the owner can say.
      fix: !there && role === 'integration' && from && from !== branch && branchOn(from) && {
        plan: `create branch ${branch} on origin from ${from}`,
        run: () => createBranch(root, branch, from),
      },
    })
  }

  if (planned?.newBoard || (config.board?.owner && config.board?.number)) {
    const { owner, number } = config.board
    // A board init is about to create has none of this yet. Its own step gives it the
    // Status options and the Priority field, and GitHub turns "Item added to project" on
    // in every new project.
    const fetched = planned?.newBoard ? { project: { id: null, fields: { nodes: [] }, views: { nodes: [] }, workflows: { nodes: [{ name: 'Item added to project', enabled: true }] } } } : fetchBoard(owner, number)
    const project = fetched.project
    const where = `${owner} project ${number}`
    if (!project) {
      add({
        name: 'board reachable', state: 'missing', detail: `${where}: ${fetched.err || 'not found, or this account has no access to it'}`, scope: 'you',
        hand: `a project's access is separate from the repo's: ask ${config.owner || 'the owner'} to add this account at ${boardUrl(owner, number)}/settings/access (if the board is gone, fix board.owner and board.number in ${configPath})`,
      })
    } else {
      const page = planned?.newBoard ? 'the new board\'s Workflows page' : `${boardUrl(owner, number)}/workflows`
      if (!planned?.newBoard) {
        add({ name: 'board reachable', state: 'ok', detail: `${where}: ${project.title}` })
        const fields = project.fields.nodes.filter((n) => n?.name)
        const status = fields.find((f) => f.name === 'Status')
        const wanted = columns(config.board.statuses)
        const have = new Map((status?.options ?? []).map((o) => [o.name, o]))
        const lacking = wanted.filter((c) => !have.has(c.name)).map((c) => c.name)
        add({
          name: 'board Status options', state: lacking.length ? 'missing' : 'ok', detail: lacking.length ? `add: ${lacking.join(', ')}` : '', board: true,
          hand: `add the Status options ${lacking.join(', ')} in the board's settings`,
          fix: lacking.length && status?.id && {
            plan: `add Status columns to the board, in Winston's order: ${lacking.join(', ')} (its existing options are kept as they are)`,
            // Existing options go back by id, untouched; ones Winston does not know follow.
            run: () => setOptions(status.id, [...wanted.map((c) => have.get(c.name) ?? c), ...status.options.filter((o) => !wanted.some((c) => c.name === o.name))]),
          },
        })
        const priority = config.board.priorityField ?? 'Priority'
        const hasPriority = fields.some((f) => f.name === priority)
        add({
          name: 'board Priority field', state: hasPriority ? 'ok' : 'missing', detail: priority, board: true,
          fix: !hasPriority && { plan: `add a single-select ${priority} field to the board (${PRIORITIES.join(', ')})`, run: () => createPriorityField(owner, number, priority) },
        })
      }
      const kanban = project.views.nodes.filter(isKanban)
      add({
        name: 'board kanban view', state: kanban.length ? 'ok' : 'missing',
        detail: kanban.length ? '' : 'no board view with Status columns', board: true,
        fix: !kanban.length && { plan: 'create a board view with Status columns, filtered to a milestone, its cards showing labels', run: () => createKanbanView(root, project) },
      })
      const labels = project.fields.nodes.find((f) => f?.name === 'Labels')
      const bare = kanban.filter((v) => !(v.fields?.nodes ?? []).some((f) => f?.name === 'Labels'))
      if (kanban.length) {
        add({
          name: 'kanban cards show labels', state: bare.length ? 'missing' : 'ok',
          detail: bare.length ? `not shown on: ${bare.map((v) => v.name).join(', ')}` : '', board: true,
          hand: 'on the view, open View and tick Labels under Fields',
          fix: bare.length && labels?.id && bare.every((v) => v.id) && {
            plan: `show Labels on the cards of: ${bare.map((v) => v.name).join(', ')}`,
            run: () => { for (const v of bare) updateView(v.id, [...v.fields.nodes.filter((f) => f?.id).map((f) => f.id), labels.id]) },
          },
        })
      }
      const milestones = planned?.noRepo ? [] : openMilestones(root)
      const hasMilestone = milestones.length > 0
      add({
        name: 'starting milestone', state: hasMilestone ? 'ok' : 'missing',
        detail: hasMilestone ? '' : 'no open milestone', board: true,
        fix: !hasMilestone && { plan: `create milestone "${DEFAULT_MILESTONE}" on the repo`, run: () => { if (!openMilestones(root).length) createMilestone(root, DEFAULT_MILESTONE) } },
      })
      // A view filtered to a milestone hides every issue that has none, and a new issue
      // has none. The current phase (config `phase`) names the milestone a workflow gives
      // each new issue. `phase: false` is the owner's choice to go without.
      if (config.phase !== false) {
        const set = typeof config.phase === 'string' && config.phase.trim() ? config.phase : null
        // The open milestones the board's views filter to. A negated filter (-milestone:)
        // and a milestone that is closed hide nothing a phase could fix.
        const filters = [...new Set(kanban.map((v) => /(?<![-\w])milestone:(?:"([^"]+)"|(\S+))/.exec(v.filter ?? '')).filter(Boolean).map((m) => m[1] ?? m[2]))].filter((m) => milestones.includes(m))
        // The phase to propose: the one milestone the board's views filter to, or, with
        // no board view yet, the one init is about to filter its new view to. Several are
        // the owner's to choose from. A board with no filtered view hides nothing, so
        // nothing is proposed.
        const target = set ?? (filters.length === 1 ? filters[0] : filters.length > 1 ? null : !kanban.length ? milestones[0] ?? DEFAULT_MILESTONE : null)
        const phaseWf = join(root, '.github', 'workflows', PHASE_WORKFLOW)
        // A phase the repo has no open milestone for: the workflow would fail on every issue.
        const gone = set && !planned?.noRepo && !milestones.includes(set) && !(set === DEFAULT_MILESTONE && !milestones.length)
        // Hidden issues only exist where a view filters to a milestone, now or once init has made it.
        const hides = filters.length > 0 || !kanban.length
        if (gone) {
          add({
            name: 'issue phase', state: 'missing', detail: `phase is "${set}", which is not an open milestone`,
            hand: `set "phase" in ${configPath} to the current milestone (open: ${milestones.join(', ') || 'none'}), or to false to leave new issues without one`,
          })
        } else if (target) {
          const done = set && existsSync(phaseWf)
          // GitHub runs the workflow from the default branch only; a file git does not
          // track, or has changes to, is not there yet.
          const committed = done && run('git', ['-C', root, 'ls-files', '--error-unmatch', '--', phaseWf]).ok && run('git', ['-C', root, 'diff', '--quiet', 'HEAD', '--', phaseWf, configPath]).ok
          add({
            name: 'issue phase', state: done ? 'ok' : 'missing',
            detail: done ? `new issues get the milestone "${set}"${committed ? '' : ` once ${PHASE_WORKFLOW} and the config are committed to the default branch`}` : `new issues get no milestone, so a board view filtered to "${target}" never shows them`,
            fix: !done && {
              plan: `give every new issue the milestone "${target}": ${set ? '' : `set "phase" to it in ${configPath}, and `}write ${phaseWf} (it takes effect once it and the config are committed to the default branch; to change phase later, edit that one config line)`,
              note: `Commit ${configPath} and ${phaseWf} to ${config.branches?.production ?? 'the default branch'}: GitHub runs the phase workflow from the default branch only, and it reads the phase from the config there.`,
              run: () => {
                if (!set) {
                  const data = JSON.parse(readFileSync(configPath, 'utf8'))
                  writeFileSync(configPath, JSON.stringify({ ...data, phase: target }, null, 2) + '\n')
                }
                if (!existsSync(phaseWf)) {
                  mkdirSync(dirname(phaseWf), { recursive: true })
                  copyFileSync(join(ROOT, 'templates', PHASE_WORKFLOW), phaseWf)
                }
              },
            },
          })
          const bare = planned?.noRepo || !hides ? [] : issuesWithoutMilestone(root)
          if (bare === null) {
            add({ name: 'issues without a milestone', required: false, state: 'unknown', detail: 'cannot list the repository\'s issues' })
          } else if (bare.length) {
            const many = bare.length === 1 ? 'issue has' : 'issues have'
            add({
              name: 'issues without a milestone', state: 'missing',
              detail: `${bare.length} open ${many} no milestone and ${bare.length === 1 ? 'is' : 'are'} hidden from a board view filtered to "${target}"`,
              fix: {
                plan: `set the milestone "${target}" on the ${bare.length} open ${many.replace(/ ha(s|ve)$/, '')} that ${bare.length === 1 ? 'has' : 'have'} none (${bare.slice(0, 12).map((n) => `#${n}`).join(', ')}${bare.length > 12 ? ', …' : ''}), so the board view shows ${bare.length === 1 ? 'it' : 'them'}; an issue that has a milestone is not touched`,
                run: () => {
                  for (const n of issuesWithoutMilestone(root) ?? []) {
                    const r = run('gh', ['issue', 'edit', n, '--milestone', target], { cwd: root })
                    if (!r.ok) throw new Error(`gh issue edit ${n}: ${r.err}`)
                  }
                },
              },
            })
          }
        } else if (filters.length > 1) {
          add({
            name: 'issue phase', required: false, state: 'off', detail: `the board's views filter to several milestones (${filters.join(', ')}) and none is named as current`,
            problem: `new issues get no milestone, so no filtered view shows them. Say which milestone is current: add "phase": "<one of ${filters.join(', ')}>" to ${configPath} (or "phase": false to go without), then run winston init --mode adopt`,
          })
        }
      }
      // New issues reach the board, at the intake status, through two of the board's own
      // workflows. GitHub's API can delete a project workflow but not create, edit or
      // enable one, so these are `browser` steps: done on the board's web page, by the
      // agent through browser control (skills/init) or by a person. The API shows only
      // whether each is on, not what it is set to do — and can say a workflow is off while
      // it is visibly still running (#45), so a workflow the API says is off gets a second
      // look at the bot's own timeline before being called missing.
      const intake = (config.board.statuses ?? DEFAULT_STATUSES)[0]
      const enabled = (name) => (project.workflows?.nodes ?? []).some((w) => w?.enabled && (w.name === name || (name === 'Auto-add to project' && /^Auto-add(?! sub-issues)/.test(w.name))))
      const apiOn = { add: enabled('Auto-add to project'), status: enabled('Item added to project') }
      const timeline = !planned?.newBoard && (!apiOn.add || !apiOn.status) ? intakeFromTimeline(root, owner, number) : null
      const stateOf = (apiSays, botSays) => (apiSays || botSays ? 'ok' : timeline && !timeline.checked ? 'unknown' : 'missing')
      add({
        name: 'board auto-adds new issues', state: stateOf(apiOn.add, timeline?.addedToProject),
        detail: apiOn.add ? '' : timeline?.addedToProject ? `on (confirmed by issue #${timeline.addedToProject}'s timeline)`
          : timeline && !timeline.checked ? 'could not check — file one test issue and rerun doctor' : 'the board\'s "Auto-add to project" workflow is off',
        board: true,
        browser: true,
        hand: `open ${page}, choose "Auto-add to project", click Edit, pick this repository and set the filter to is:issue, then click "Save and turn on workflow"`,
      })
      add({
        name: `board sets ${intake} on added items`, state: stateOf(apiOn.status, timeline?.statusChanged),
        detail: apiOn.status ? `on; GitHub's API does not show which Status it sets`
          : timeline?.statusChanged ? `on (confirmed by issue #${timeline.statusChanged}'s timeline); GitHub's API does not show which Status it sets`
          : timeline && !timeline.checked ? 'could not check — file one test issue and rerun doctor' : 'the board\'s "Item added to project" workflow is off',
        board: true,
        browser: true,
        hand: `open ${page}, choose "Item added to project", click Edit, under Set value choose Status: ${intake}, then click "Save and turn on workflow"`,
      })
    }
  }

  const labels = planned?.noRepo ? { ok: true, out: '' } : run('gh', ['label', 'list', '--limit', '1000', '--json', 'name', '--jq', '.[].name'], { cwd: root })
  if (!labels.ok) {
    add({ name: 'triage labels', state: 'missing', detail: `cannot list labels: ${labels.err}` })
  } else {
    const have = new Set(labels.out.split('\n'))
    const lacking = requiredLabels(config).filter((l) => !have.has(l.name))
    add({
      name: 'triage labels', state: lacking.length ? 'missing' : 'ok',
      detail: lacking.length ? `missing: ${lacking.map((l) => l.name).join(', ')}` : '',
      fix: lacking.length && {
        plan: `create labels: ${lacking.map((l) => l.name).join(', ')}`,
        run: () => {
          for (const l of lacking) {
            const r = run('gh', ['label', 'create', l.name, ...(l.color ? ['--color', l.color] : []), ...(l.description ? ['--description', l.description] : [])], { cwd: root })
            if (!r.ok) throw new Error(`gh label create ${l.name}: ${r.err}`)
          }
        },
      },
    })
  }

  // The triage skill is an engine: with no policy it stops, and under a doc with no triage
  // rules it runs and changes nothing. init offers a starter and never overwrites a file.
  const policy = config.triage?.policy ?? DEFAULT_POLICY
  // A policy is a doc in the repo: a path that leaves it is not read.
  const inRepo = typeof policy === 'string' && !isAbsolute(policy) && !relative(root, resolve(root, policy)).startsWith('..')
  const policyIs = inRepo ? policyState(resolve(root, policy)) : 'outside'
  const starter = join(root, DEFAULT_POLICY)
  const starterIs = policy === DEFAULT_POLICY ? policyIs : policyState(starter)
  const repoint = () => {
    if (policy === DEFAULT_POLICY || !existsSync(configPath)) return
    const data = JSON.parse(readFileSync(configPath, 'utf8'))
    writeFileSync(configPath, JSON.stringify({ ...data, triage: { ...data.triage, policy: DEFAULT_POLICY } }, null, 2) + '\n')
  }
  const andPoint = policy === DEFAULT_POLICY ? '' : `, and set triage.policy to it in ${configPath} (${policy} is left as it is)`
  add({
    name: 'triage policy', state: policyIs === 'ok' ? 'ok' : 'missing',
    detail: policyIs === 'ok' ? policy : policyIs === 'outside' ? `triage.policy must be a file inside the repository, got: ${policy}` : policyIs === 'missing' ? `${policy} not found: /winston:triage does not run without a policy` : `${policy} has no triage rules (no heading that names triage, no risk: low/medium/high tier): a triage pass under it changes nothing`,
    hand: `${starter} exists and has no triage rules, and Winston does not overwrite it: write the rules into it (a starter to copy from: ${join(ROOT, 'templates', 'TRIAGE.md')})${policy === DEFAULT_POLICY ? '' : `, then set triage.policy to ${DEFAULT_POLICY} in ${configPath}`}`,
    fix: policyIs !== 'ok' && (starterIs === 'ok'
      ? { plan: `set triage.policy to ${DEFAULT_POLICY}, which has triage rules, in ${configPath} (${policy} is left as it is)`, run: repoint }
      : starterIs === 'missing' && {
        plan: `write ${starter}, a starter triage policy filled in from the config${andPoint}. Its three (per-repo) sections are generic: the risk tiers must be written for this repo before triage can judge anything (/winston:init can propose them from reading the repo, for the owner to approve), and the file takes effect once committed to the default branch`,
        starter,
        run: () => { writeStarterPolicy(starter, config); repoint() },
      }),
  })

  const blanks = policyIs === 'ok' ? policyBlanks(resolve(root, policy)) : []
  if (blanks.length) {
    add({
      name: 'triage policy blanks', required: false, state: 'off',
      detail: `${policy} has ${blanks.length} ${blanks.length === 1 ? 'line' : 'lines'} still to fill in`,
      problem: `${policy} has ${blanks.length} ${blanks.length === 1 ? 'line' : 'lines'} still to fill in (open the file and replace each "fill this in" or {{placeholder}} with the real value): ${blanks.join('; ')}`,
      blanks: { file: resolve(root, policy), lines: blanks },
    })
  }
  if (policyIs === 'ok' && STARTER_TIER.test(readFileSync(resolve(root, policy), 'utf8'))) {
    add({
      name: 'triage risk tiers', required: false, state: 'off',
      detail: `${policy} still has the starter's example risk tiers`,
      problem: `open ${policy} and rewrite the three rows under "Risk tiers" for this repository: what breaks for a user if a change of that kind is wrong, naming real paths. /winston:init can propose them from reading the repo, for you to approve. Then commit the file to the default branch`,
    })
  }

  const wfName = typeof config.triage?.workflow === 'string' ? config.triage.workflow : DEFAULT_TRIAGE_WORKFLOW
  const wf = join(root, '.github', 'workflows', wfName)
  // `triage.workflow: false` is the owner's choice to keep another workflow as the repo's triage.
  const declined = config.triage?.workflow === false
  // Another workflow that triages a new issue. Two would give every issue two verdicts, so
  // which stays is the owner's choice (init --triage), recorded so it is asked once.
  const alongside = Array.isArray(config.triage?.alongside) ? config.triage.alongside : []
  const rivals = declined || planned?.noRepo ? [] : otherTriageWorkflows(root, wfName).filter((n) => !alongside.includes(n))
  const keep = choice === 'keep' && rivals.length > 0
  // init's first commit, when it makes one, writes the workflow itself.
  const hasWf = existsSync(wf) || !!planned?.firstCommit
  const writePlan = `write ${wf} from the template (it skips until the repo has the secrets ${TRIAGE_SECRETS.join(' and ')}; the steps for those are below)`
  if (declined) {
    add({ name: 'triage-on-new-issue workflow', required: false, state: 'off', detail: `not installed, by choice: triage.workflow is false in ${configPath}` })
  } else if (rivals.length && !hasWf) {
    // Not written until the owner has chosen; the conflict below carries the choice.
    add({ name: 'triage-on-new-issue workflow', required: false, state: 'off', detail: `not written: ${rivals.join(', ')} already ${rivals.length === 1 ? 'triages' : 'triage'} new issues` })
  } else {
    add({ name: 'triage-on-new-issue workflow', state: hasWf ? 'ok' : 'missing', detail: wf, fix: !hasWf && { plan: writePlan, run: () => writeTriageWorkflow(wf) } })
  }
  if (rivals.length) {
    const names = rivals.join(', ')
    const files = rivals.map((n) => join(root, '.github', 'workflows', n))
    const onDisk = existsSync(wf)
    const plans = {
      keep: `keep ${names} as this repository's triage: ${onDisk ? `delete ${wf}, and ` : ''}set triage.workflow to false in ${configPath}`,
      replace: `make Winston's workflow the only triage: ${onDisk ? '' : `write ${wf} from the template, and `}delete ${files.join(', ')} (it stops running once the deletion is committed to the default branch)`,
      both: `keep both, knowingly: ${onDisk ? '' : `write ${wf} from the template, and `}record ${names} under triage.alongside in ${configPath}; every new issue is then triaged twice`,
    }
    const runs = {
      keep: () => { if (existsSync(wf)) rmSync(wf); patchTriage(configPath, { workflow: false }) },
      replace: () => { if (!existsSync(wf)) writeTriageWorkflow(wf); for (const f of files) rmSync(f, { force: true }) },
      both: () => { if (!existsSync(wf)) writeTriageWorkflow(wf); patchTriage(configPath, { alongside: [...alongside, ...rivals] }) },
    }
    add({
      name: 'triage workflow conflicts', required: false, state: 'off',
      detail: `${names} also ${rivals.length === 1 ? 'triages' : 'triage'} every new issue`,
      problem: `${names} and ${wfName} would both triage every new issue: two comments, two risk: decisions, and one may start work the other stopped on. Choose which stays: winston init --mode adopt --triage keep   (keep ${names}), --triage replace   (keep Winston's, delete ${names}), or --triage both   (keep both, knowingly)`,
      conflict: { rivals, plans },
      fix: plans[choice] && {
        plan: plans[choice], run: runs[choice],
        note: choice === 'replace' && `Commit the deletion of ${files.join(', ')} to ${config.branches?.production ?? 'the default branch'}: until then it still runs on every new issue.`,
      },
    })
  }
  if ((existsSync(wf) || forInit) && !declined && !keep && !(rivals.length && !hasWf && !choice)) {
    // Names only. A repo init is about to create has no secrets; one whose secrets this
    // account cannot list is unknown, never missing.
    const slug = planned?.slug ?? (run('gh', ['repo', 'view', '--json', 'nameWithOwner', '--jq', '.nameWithOwner'], { cwd: root }).out || null)
    const listed = planned?.noRepo ? { ok: true, out: '' } : run('gh', ['secret', 'list', ...(slug ? ['--repo', slug] : []), '--json', 'name', '--jq', '.[].name'], { cwd: root })
    const have = new Set(listed.out.split('\n'))
    const lacking = TRIAGE_SECRETS.filter((n) => !have.has(n))
    const init = 'winston init --mode adopt prints the steps'
    add({
      name: 'triage workflow secrets', required: false, state: !listed.ok ? 'unknown' : lacking.length ? 'off' : 'ok',
      detail: !listed.ok ? 'this account cannot list the repo\'s secrets' : `${TRIAGE_SECRETS.map((n) => `${n} ${have.has(n) ? 'set' : 'missing'}`).join(', ')}${lacking.length ? ' — new issues are not triaged automatically until both are set' : ''}`,
      problem: listed.ok && lacking.length && `secrets missing: ${lacking.join(', ')}. New issues are not triaged automatically until both are set (${init})`,
      steps: (!listed.ok || lacking.length) && (() => secretSteps({ slug, known: listed.ok, want: listed.ok ? lacking : TRIAGE_SECRETS, boardOwner: config.board?.owner, wfName })),
    })
  }
  if (existsSync(wf) && !planned && !declined) {
    const runs = run('gh', ['run', 'list', '--workflow', wfName, '--limit', String(TRIAGE_RUNS), '--json', 'conclusion', '--jq', '.[].conclusion'], { cwd: root })
    // Newest first; a run still going has no conclusion yet.
    const done = runs.out.split('\n').filter((c) => c && c !== 'null')
    const failed = done.findIndex((c) => !FAILED_RUNS.includes(c))
    const n = failed === -1 ? done.length : failed
    add({
      name: 'triage workflow runs', required: false, state: !runs.ok ? 'unknown' : n ? 'failed' : done[0] === 'success' ? 'ok' : 'off',
      detail: !runs.ok ? 'cannot list its runs (GitHub knows a workflow only once it is on the default branch)' : n ? `its last ${n} ${n === 1 ? 'run' : 'runs'} failed` : done.length ? `last run: ${done[0]}` : 'no finished runs yet',
      problem: runs.ok && n > 0 && `installed, but its last ${n} ${n === 1 ? 'run' : 'runs'} failed. See why: gh run list --workflow ${wfName} --limit 1, then gh run view <id> --log-failed. A missing, expired or under-scoped secret is the usual cause (winston init --mode adopt prints the steps for a missing one)`,
    })
  }

  // The project's allow rules are the owner's to add, in one step: winston permissions --apply.
  let perms
  try {
    perms = permissionState(root, config)
  } catch (e) {
    perms = { error: e.message }
  }
  const lackingRules = [...(perms.rules ?? []), ...(perms.denies ?? [])].filter((r) => r.state === 'missing')
  const lackingAllow = lackingRules.filter((r) => !r.deny).length
  const lackingText = `${lackingAllow} allow and ${lackingRules.length - lackingAllow} deny rules Winston runs use are not in ${perms.path}`
  add({
    name: 'project permission rules', required: false, state: perms.error ? 'unknown' : lackingRules.length ? 'off' : 'ok',
    detail: perms.error ?? (lackingRules.length ? `${lackingText}${lackingRules.length > 3 ? '' : `: ${lackingRules.map((r) => r.rule).join(', ')}`} (winston permissions --apply adds them)` : perms.path),
    ownerStep: lackingRules.length > 0 && [
      `${lackingText}, so routine actions prompt during a run and the risky forms of them are not blocked.`,
      'Run it yourself, once: winston permissions --apply   (winston permissions lists them first)',
      `It adds to the project's permissions.allow and permissions.deny and changes nothing else. ${GATES}`,
    ],
  })

  // Optional: features that use these degrade cleanly without them.
  add({ name: 'codex CLI', required: false, state: onPath('codex') ? 'on' : 'off', detail: 'optional: Rex, /winston:codex' })
  add({ name: 'chattr CLI', required: false, state: onPath('chattr') ? 'on' : 'off', detail: 'optional: peer messages, claims' })
  const gemini = process.platform === 'darwin' && run('security', ['find-generic-password', '-s', 'GEMINI_API_KEY']).ok
  add({ name: 'GEMINI_API_KEY in keychain', required: false, state: gemini ? 'on' : 'off', detail: 'optional: /winston:gemini' })
  const agents = codexSources()
  const stale = agents.filter((a) => !existsSync(a.dst) || readFileSync(a.dst, 'utf8') !== readFileSync(a.src, 'utf8'))
  add({
    name: 'Codex agents installed', required: false,
    state: agents.length && !stale.length ? 'on' : 'off',
    detail: !agents.length ? 'this plugin ships none' : stale.length ? `optional: not installed or differ: ${stale.map((a) => a.name).join(', ')} (winston install-codex-agents)` : '',
  })
  return out
}

const missing = (list) => list.filter((c) => c.required && c.state === 'missing')

/** One sentence on why each check matters, by its name. */
const WHY = [
  [/^claude on PATH/, 'Winston runs inside Claude Code.'],
  [/^gh auth/, 'Winston reads and updates issues and the board through the gh command.'],
  [/^(repo config|git repository)/, 'The config tells Winston which branches and board this repository uses.'],
  [/branch on origin$/, 'Work lands on the integration branch and is released from the production branch.'],
  [/^board reachable/, 'The board is where Winston finds work and records its state.'],
  [/^board (Status|Priority)/, 'Winston moves work through these statuses and sorts it by priority.'],
  [/^board kanban view/, 'A board view grouped by status is how you see the work at a glance.'],
  [/^starting milestone/, 'The board view is filtered to a milestone, so there must be one.'],
  [/^issue phase/, 'A board view filtered to a milestone hides an issue that has none, and a new issue has none.'],
  [/^issues without a milestone/, 'They are on the board and missing from the view filtered to the current milestone.'],
  [/^board (auto-adds|sets)/, 'Without this a new issue never shows up on the board.'],
  [/^triage labels/, 'Triage records its judgment with these labels.'],
  [/^triage policy blanks/, 'Triage reads these lines as they stand, so a blank becomes part of the rule.'],
  [/^triage policy/, 'Triage takes every rule from this file. Without rules a triage run finishes and changes nothing.'],
  [/^triage risk tiers/, 'The example tiers describe no real repository, so triage cannot judge risk here until they are rewritten.'],
  [/^triage-on-new-issue workflow/, 'This is what triages a new issue without anyone asking.'],
  [/^triage workflow conflicts/, 'Two workflows that triage the same issue give it two verdicts, and one may start work the other stopped on.'],
  [/^triage workflow secrets/, 'The workflow cannot sign in to GitHub or Claude without them, so new issues stay untriaged.'],
  [/^triage workflow runs/, 'Failed runs mean new issues are not being triaged, and nothing else reports it.'],
  [/^project permission rules/, 'Without these rules a long run stops to ask permission for routine commands.'],
  [/^Winston version/, 'Newer versions fix setup problems like the ones this checklist looks for.'],
]

/** The plain word for a check: done, needs you, could not check, or on/off for an optional tool. */
export function statusOf(c) {
  if (c.state === 'ok') return 'done'
  if (c.state === 'unknown') return 'could not check'
  if (c.state === 'on' || (c.state === 'off' && !c.problem && !c.steps && !c.ownerStep)) return c.state
  return 'needs you'
}

/** How to close an open item: { command } for one paste-ready command, and the lines to show. */
function fixOf(c) {
  if (c.steps) {
    const lines = c.steps()
    return { lines, ...lines.next }
  }
  if (c.ownerStep) return { command: 'winston permissions --apply', lines: ['Run it yourself, once: winston permissions --apply   (winston permissions lists the rules first)'] }
  if (c.command) return { command: c.command, lines: c.fixLines }
  if (c.unconfigured) return { command: 'winston init', lines: ['winston init   (or /winston:init; it asks which setup fits: join, new or adopt, and shows its plan before changing anything)'] }
  if (c.fix) return { command: 'winston init --mode adopt', lines: [`winston init --mode adopt   (or /winston:init; it shows this plan first, then asks: ${c.fix.plan})`] }
  if (c.browser) return { lines: [`/winston:init does this for you in the browser. By hand: ${c.hand}`] }
  return { lines: [c.problem || c.hand || c.detail] }
}

/** The steps no API call can take: those done on a web page, then the rest. */
function printSteps(items) {
  const browser = items.filter((c) => c.browser)
  const hand = items.filter((c) => !c.browser)
  if (browser.length) {
    console.log('\nIn the browser (GitHub has no API for these; /winston:init does them through Claude in Chrome, or do them yourself):')
    for (const c of browser) console.log(`  - ${c.name}: ${c.hand}`)
  }
  if (hand.length) {
    console.log('\nBy hand:')
    for (const c of hand) console.log(`  - ${c.name}: ${c.hand || c.detail}`)
  }
}

/**
 * Browser checks doctor could not confirm either way (state `unknown`, e.g. no issues yet
 * to read a timeline from, #45): never required, never performed automatically, but still
 * worth the owner's or agent's knowledge that the step exists, in case it is genuinely off.
 */
function printMaybe(list) {
  const maybe = list.filter((c) => c.browser && c.state === 'unknown')
  if (!maybe.length) return
  console.log('\nCould not confirm (may already be on; optional, in the browser):')
  for (const c of maybe) console.log(`  - ${c.name}: ${c.hand}`)
}

/**
 * The installed version against the latest. The answer comes from the update check's
 * cache, so GitHub is asked at most once a day (once an hour after a failed lookup).
 * Never a required check: a stale Winston still works.
 */
function versionCheck(cwd) {
  const have = installedVersion()
  const asked = run(process.execPath, [join(ROOT, 'lib', 'update.mjs')], { timeout: 8000 })
  let latest = null
  try {
    latest = JSON.parse(asked.out).latest
  } catch {}
  const base = { name: 'Winston version', required: false, scope: 'you' }
  if (!latest) return { ...base, state: 'unknown', detail: `${have} installed; could not reach GitHub to check for a newer one` }
  if (!newer(latest, have)) return { ...base, state: 'ok', detail: `${have}, the latest` }
  const steps = updateSteps('claude', installScope(cwd))
  return {
    ...base, state: 'off', detail: `${have} installed, ${latest} available`, problem: `update to ${latest}`,
    command: steps.match(/`([^`]+)`/)?.[1],
    fixLines: [`To update, ${steps}.`, 'Winston never updates itself: an update replaces hooks and skills and needs a restart.'],
  }
}

/**
 * The checklist: every check with a plain status, then each open item with why it
 * matters and how to close it, then one "Next step:" line naming the first. Read-only,
 * apart from Winston's own state directory: the result is kept there for the
 * session-start nudge, and the version check keeps its answer there.
 */
function doctor(cwd, copy = false) {
  const list = checks(cwd)
  const version = versionCheck(cwd)
  if (version) list.splice(list.findIndex((c) => c.name === 'codex CLI'), 0, { detail: '', ...version })
  const root = repoRoot(cwd)
  console.log(`Winston setup checklist${root ? ` for ${root}` : ''}. Safe to run again: it only reads.\n`)
  for (const c of list) console.log(`${statusOf(c).padEnd(16)} ${c.name}${c.detail ? `  — ${c.detail}` : ''}`)

  // A repo with no config has one thing to do; the rest follows from it.
  const all = list.filter((c) => statusOf(c) === 'needs you')
  const open = all.some((c) => c.unconfigured) ? all.filter((c) => c.unconfigured || c.scope === 'you') : all
  const blind = list.filter((c) => statusOf(c) === 'could not check')
  if (root) {
    try {
      const file = doctorResultPath(root)
      mkdirSync(dirname(file), { recursive: true })
      writeFileSync(file, JSON.stringify({ root, open: open.length, at: new Date().toISOString() }))
    } catch {}
  }
  const code = missing(list).length ? 1 : 0
  if (!open.length) {
    if (copy) console.log('\nNothing was copied: there is no next step.')
    console.log(`\nSetup is complete: nothing needs you.${blind.length ? ` ${blind.length} ${blind.length === 1 ? 'item' : 'items'} could not be checked from this account or network.` : ''}`)
    return code
  }
  console.log(`\nNeeds you (${open.length}):`)
  const fixes = open.map(fixOf)
  for (const [i, c] of open.entries()) {
    console.log(`\n${i + 1}. ${c.name}`)
    const why = WHY.find(([re]) => re.test(c.name))?.[1]
    if (why) console.log(`   Why: ${why}`)
    console.log('   Fix:')
    for (const line of fixes[i].lines) console.log(`     ${line}`)
  }
  const { open: link } = fixes[0]
  const command = fixes[0].command ?? link
  let copied = ''
  if (copy) {
    const done = command && process.platform === 'darwin' && spawnSync('pbcopy', { input: command }).status === 0
    if (done) copied = '   (copied to the clipboard)'
    else console.log(`\nNothing was copied: ${!command ? 'the next step is several steps, not one command' : process.platform !== 'darwin' ? '--copy works on macOS only' : 'pbcopy did not run'}.`)
  }
  console.log(`\nNext step: ${open[0].name} – ${link ? `open ${link}${copied} and follow the steps under 1 above` : command ? `run: ${command}${copied}` : 'follow the steps under 1 above'}. Then run winston doctor again.`)
  return code
}

/** What this directory is, read-only: the facts the three setups differ on. */
function situation(cwd) {
  const root = repoRoot(cwd)
  const git = (...args) => run('git', ['-C', root, ...args])
  const hasConfig = !!root && existsSync(join(root, '.winston', 'config.json'))
  const hasCommits = !!root && git('rev-parse', '--verify', '-q', 'HEAD').ok
  const origin = (root && git('remote', 'get-url', 'origin').out) || null
  let mode, why
  if (hasConfig) [mode, why] = ['join', `${join(root, '.winston', 'config.json')} exists`]
  else if (!root) [mode, why] = ['new', `${cwd} is not a git repository`]
  else if (!hasCommits) [mode, why] = ['new', 'the repository has no commits']
  else if (!origin) [mode, why] = ['new', 'the repository has no origin remote']
  else [mode, why] = ['adopt', 'the repository has history and an origin, and no .winston/config.json']
  return { root, hasConfig, hasCommits, origin, mode, why }
}

function ask(sit) {
  console.log('Which of these is this repository?')
  console.log('  join    Already set up for Winston by someone else. Check my access and my machine;')
  console.log('          change nothing in the repo or on GitHub.')
  console.log('  new     A new project. Create the GitHub repo, both branches, the board and the config.')
  console.log('  adopt   An existing repo that Winston did not set up. Fit a config to its branches,')
  console.log('          board and docs, and add only what is missing.')
  console.log(`\nLooks like: ${sit.mode} — ${sit.why}.`)
  console.log('\nRun: winston init --mode <join|new|adopt>   (prints the plan; --yes applies it)')
}

/** join: the repo's setup is someone else's. Report; write nothing outside this machine. */
function join_(cwd, sit, yes) {
  if (!sit.hasConfig) {
    console.log('There is no .winston/config.json here, so this checkout is not set up for Winston.')
    console.log('If the repo is, pull the branch that holds its config. Otherwise: winston init --mode adopt')
    console.log(DOCTOR_POINTER)
    return 1
  }
  const list = checks(cwd)
  const layers = loadLayers(cwd)
  const owner = { ...layers.user.data, ...layers.repo.data }.owner || 'the owner'
  const bad = missing(list)
  const yours = bad.filter((c) => c.scope === 'you')
  const theirs = bad.filter((c) => c.scope !== 'you')
  console.log(`Joining ${sit.root}. Its setup is ${owner}'s: nothing in the repo or on GitHub is changed.`)
  if (!bad.length) console.log('\nReady: every required check passes.')
  if (yours.length) {
    console.log('\nYours to fix:')
    for (const c of yours) console.log(`  - ${c.name}: ${c.hand || c.detail}`)
  }
  if (theirs.length) {
    console.log(`\nGaps in the repo's own setup. They are ${owner}'s to close (winston init --mode adopt), not yours:`)
    for (const c of theirs) console.log(`  - ${c.name}${c.detail ? ` — ${c.detail}` : ''}`)
  }
  // The launchers read launcher.repo from the user layer only, so the repo's copy never
  // reaches a second person. Set it when they have none; never replace one.
  const userPath = join(winstonHome(), 'config.json')
  if (!layers.user.data.launcher?.repo) {
    const shown = sit.root.startsWith(homedir() + '/') ? `~${sit.root.slice(homedir().length)}` : sit.root
    const plan = `set launcher.repo to ${shown} in ${userPath} (the session launchers open that checkout)`
    if (!yes) {
      console.log(`\nOn this machine, init would:\n  - ${plan}\n\nRerun with --yes to do that.`)
    } else {
      mkdirSync(dirname(userPath), { recursive: true })
      writeFileSync(userPath, JSON.stringify({ ...layers.user.data, launcher: { ...layers.user.data.launcher, repo: shown } }, null, 2) + '\n')
      console.log(`\ndone     ${plan}`)
    }
  }
  return yours.length ? 1 : 0
}

/**
 * The first steps for a repo with no config: settle the GitHub repo, the two branches and
 * the board, then write a config that describes them. Read-only until a step's run().
 * Returns { steps, notes, planned } or { boards } when the owner must pick a board.
 */
function bootstrap(cwd, sit, opts) {
  const root = sit.root ?? cwd
  const git = (...args) => run('git', ['-C', root, ...args])
  const login = run('gh', ['api', 'user', '--jq', '.login']).out
  if (!login) throw new Error(`gh is not logged in. Run: gh auth login, then: gh auth refresh -s project\n${DOCTOR_POINTER}`)

  const noRepo = !sit.origin
  let slug
  if (noRepo) slug = opts.repo || `${login}/${basename(root)}`
  else {
    const view = run('gh', ['repo', 'view', '--json', 'nameWithOwner', '--jq', '.nameWithOwner'], { cwd: root })
    if (!view.ok) throw new Error(`origin (${sit.origin}) is not a GitHub repository gh can read: ${view.err}\n${DOCTOR_POINTER}`)
    slug = view.out
  }
  const [ghOwner, name] = slug.split('/')
  if (!ghOwner || !name) throw new Error(`--repo takes <owner>/<name>, got: ${slug}`)

  // Branches: production is what the repo already treats as its default.
  let production, heads = []
  if (noRepo) production = (sit.root && git('symbolic-ref', '--short', 'HEAD').out) || 'main'
  else {
    heads = git('ls-remote', '--heads', 'origin').out.split('\n').map((l) => l.split('refs/heads/')[1]).filter(Boolean)
    production = git('ls-remote', '--symref', 'origin', 'HEAD').out.match(/^ref: refs\/heads\/(\S+)\s+HEAD/m)?.[1]
    if (!production) throw new Error(`cannot read origin's default branch (is the remote empty?)\n${DOCTOR_POINTER}`)
  }
  const integration = opts.integration || INTEGRATION_NAMES.find((b) => b !== production && heads.includes(b)) || 'staging'

  // Board: an existing one is used as it stands; only a new project gets created.
  let board = null
  if (opts.board && opts.board !== 'new') {
    const [owner, number] = opts.board.split('/')
    if (!owner || !/^\d+$/.test(number ?? '')) throw new Error(`--board takes <owner>/<number> or new, got: ${opts.board}`)
    board = { owner, number: Number(number) }
    if (!fetchBoard(owner, board.number).project) throw new Error(`--board ${opts.board}: no such project, or this account has no access to it\n${DOCTOR_POINTER}`)
  } else if (!opts.board && !noRepo) {
    const linked = run('gh', ['api', 'graphql', '-f', `query=${LINKED_BOARDS_QUERY}`, '-f', `owner=${ghOwner}`, '-f', `name=${name}`])
    let nodes = []
    try {
      nodes = JSON.parse(linked.out).data.repository.projectsV2.nodes.filter((n) => n && !n.closed)
    } catch {
      throw new Error(`cannot list the projects linked to ${slug}: ${linked.err || linked.out}\n${DOCTOR_POINTER}`)
    }
    if (nodes.length > 1) return { boards: nodes.map((n) => ({ owner: n.owner.login, number: n.number, title: n.title })) }
    if (nodes.length === 1) board = { owner: nodes[0].owner.login, number: nodes[0].number }
  }
  const newBoard = !board
  const statuses = DEFAULT_STATUSES

  const present = (f) => existsSync(join(root, f))
  const processDocs = PROCESS_DOCS.filter(present)
  const config = {
    owner: opts.owner || (sit.root && git('config', 'user.name').out) || login,
    branches: { integration, production },
    board: { owner: board?.owner ?? ghOwner, number: board?.number ?? null, statuses, priorityField: 'Priority' },
    processDocs,
    // The first doc that already holds triage rules; otherwise the starter init writes.
    triage: { policy: [DEFAULT_POLICY, ...processDocs].find((f) => policyState(join(root, f)) === 'ok') ?? DEFAULT_POLICY, workflow: DEFAULT_TRIAGE_WORKFLOW, labels: [] },
    worktree: { copy: ['.env.local', '.env'].filter(present), link: present('package.json') ? ['node_modules'] : [] },
  }
  const configPath = join(root, '.winston', 'config.json')
  const wf = join(root, '.github', 'workflows', DEFAULT_TRIAGE_WORKFLOW)
  const must = (r, what) => { if (!r.ok) throw new Error(`${what}: ${r.err || r.out}`) }

  const steps = []
  if (!sit.root) steps.push({ plan: `git init in ${root}, on branch ${production}`, run: () => must(run('git', ['init', '-q', '-b', production, root]), 'git init') })
  // A new project's own workflows point at its default options: "Item added to project" at
  // Todo, and the closing ones at Done. Each stock option is kept by id under the column
  // that takes its place, so Todo becomes the intake column and that workflow sets it.
  const configureNewBoard = () => {
    const status = fetchBoard(ghOwner, config.board.number).project?.fields.nodes.find((f) => f?.name === 'Status')
    if (!status?.id) throw new Error('cannot read the new project\'s Status field')
    const stock = (n) => status.options.find((o) => o.name === n)?.id
    setOptions(status.id, columns(statuses).map((c, i) => ({ ...c, id: stock(i === 0 ? 'Todo' : c.name) })))
    createPriorityField(ghOwner, config.board.number, 'Priority')
    for (const name of DATE_FIELDS) createDateField(ghOwner, config.board.number, name)
  }
  if (newBoard) {
    steps.push({
      plan: `create a private GitHub Project "${name}" under ${ghOwner}, with Status columns ${columns(statuses).map((c) => c.name).join(' / ')}, a Priority field (${PRIORITIES.join(', ')}) and Start and Target date fields`,
      run: () => {
        const made = run('gh', ['project', 'create', '--owner', ghOwner, '--title', name, '--format', 'json'])
        must(made, 'gh project create')
        config.board.number = JSON.parse(made.out).number
        try {
          configureNewBoard()
        } catch (e) {
          // The project exists and is not linked yet, so a plain rerun would not find it.
          throw new Error(`${e.message}. ${ghOwner} project ${config.board.number} was created: rerun with --board ${ghOwner}/${config.board.number} to use it rather than make another`)
        }
      },
    })
  }
  steps.push({
    plan: `write ${configPath}: production ${production}, integration ${integration}, board ${newBoard ? 'the new one' : `${board.owner} project ${board.number}`}, process docs ${processDocs.join(', ') || 'none found'}`,
    run: () => { mkdirSync(dirname(configPath), { recursive: true }); writeFileSync(configPath, JSON.stringify(config, null, 2) + '\n') },
  })
  if (!sit.hasCommits) {
    steps.push({
      plan: 'make the first commit: the Winston config and the triage workflow, nothing else',
      run: () => {
        writeTriageWorkflow(wf)
        must(git('add', '--', configPath, wf), 'git add')
        must(git('commit', '-q', '-m', 'Add Winston configuration', '--', configPath, wf), 'git commit')
      },
    })
  }
  if (noRepo) {
    steps.push({
      plan: `create the ${opts.public ? 'public' : 'private'} GitHub repository ${slug} from this directory and push ${production}`,
      run: () => must(run('gh', ['repo', 'create', slug, opts.public ? '--public' : '--private', '--source', root, '--remote', 'origin', '--push'], { timeout: PUSH_TIMEOUT }), 'gh repo create'),
    })
  }
  if (integration !== production && !heads.includes(integration)) {
    steps.push({
      plan: `create branch ${integration} on origin from ${production}`,
      run: () => createBranch(root, integration, production),
    })
  }
  if (newBoard) {
    steps.push({
      plan: `link the new board to ${slug}`,
      run: () => must(run('gh', ['project', 'link', String(config.board.number), '--owner', ghOwner, '--repo', name]), 'gh project link'),
    })
  }

  const notes = []
  if (sit.hasCommits) notes.push({ withWorkflow: `Commit ${configPath} and ${wf} to ${production}: GitHub runs the triage workflow from the default branch only.`, without: `Commit ${configPath} to ${production}, so the setup is there for everyone who works in the repository.` })
  notes.push(`No deploy gate is set. If merges into ${production} deploy, add deployGate to the config (see the README).`)
  return { steps, notes, planned: { config, newBoard, noRepo, firstCommit: !sit.hasCommits, slug } }
}

/** new and adopt: build what is missing. With a config already here, that config is the plan. */
function setup(cwd, sit, opts) {
  if (opts.mode === 'adopt' && !sit.hasConfig && !(sit.root && sit.hasCommits && sit.origin)) {
    console.log(`adopt needs an existing repository with history and an origin remote, and ${sit.why}. For a new project: winston init --mode new`)
    return 1
  }
  const boot = sit.hasConfig ? null : bootstrap(cwd, sit, opts)
  if (boot?.boards) {
    console.log('More than one GitHub Project is linked to this repository. Which is the Winston board?')
    for (const b of boot.boards) console.log(`  --board ${b.owner}/${b.number}   ${b.title}`)
    console.log('  --board new   create a new one')
    return opts.yes ? 2 : 0
  }
  const list = checks(cwd, boot?.planned, true, opts.triage)
  // What init does: every required gap it can close, and the owner's answered choices.
  const fixable = (l) => l.filter((c) => c.fix && ((c.required && c.state === 'missing') || c.conflict))
  const fixes = fixable(list)
  const hand = missing(list).filter((c) => !c.fix)
  const printHand = printSteps
  // Winston's triage workflow is not written while another one waits on the owner's choice, or is kept.
  const bootNotes = (l) => (boot?.notes ?? []).map((n) => (typeof n === 'string' ? n : l.some((c) => c.conflict && (!c.fix || opts.triage === 'keep')) ? n.without : n.withWorkflow))
  // A second triage workflow is the owner's choice, never a guess: asked until answered.
  const printChoice = (l) => {
    const c = l.find((x) => x.conflict && !x.fix)
    if (!c) return
    console.log(`\nTriage workflow, your choice: ${c.detail}, and Winston's would too. Rerun with one of:`)
    for (const [flag, plan] of Object.entries(c.conflict.plans)) console.log(`  --triage ${flag.padEnd(8)} ${plan}`)
    console.log('Until you choose, init leaves the triage workflows as they are.')
  }
  if (!boot && !fixes.length && !hand.length) {
    console.log(`${ownerSteps(list) ? 'Every required check passes' : 'Nothing to do: every required check passes'}. Nothing was changed. Safe to run again.`)
    printChoice(list)
    printMaybe(list)
    printOwnerSteps(list)
    return 0
  }
  const plans = [...(boot?.steps ?? []), ...fixes.map((c) => c.fix)]
  if (!opts.yes) {
    if (plans.length) {
      console.log(`winston init --mode ${opts.mode} would:`)
      for (const p of plans) console.log(`  - ${p.plan}`)
    }
    printHand(hand)
    printChoice(list)
    printMaybe(list)
    printOwnerSteps(list)
    for (const n of [...bootNotes(list), ...fixes.map((c) => c.fix.note).filter(Boolean)]) console.log(`\nNote: ${n}`)
    if (plans.length) console.log('\nNothing was changed. Rerun with --yes to do these. Safe to run again: steps already done are skipped, and nothing existing is overwritten.')
    return 0
  }

  // First steps run in order and each needs the one before it, so the first failure stops.
  const first = boot?.steps ?? []
  for (const [i, step] of first.entries()) {
    try {
      step.run()
      console.log(`done     ${step.plan}`)
    } catch (e) {
      console.log(`failed   ${step.plan}: ${e.message}`)
      for (const later of first.slice(i + 1)) console.log(`not run  ${later.plan}`)
      return 1
    }
  }
  // The config exists now, so the checks read the real repo and board.
  const after = boot ? checks(cwd, null, true, opts.triage) : list
  let failed = 0
  let written = null
  const ranNotes = []
  for (const c of fixable(after)) {
    try {
      c.fix.run()
      if (c.fix.note) ranNotes.push(c.fix.note)
      if (c.fix.starter) written = c.fix.starter
      console.log(`done     ${c.fix.plan}`)
    } catch (e) {
      failed++
      console.log(`failed   ${c.fix.plan}: ${e.message}`)
    }
  }
  printHand(missing(after).filter((c) => !c.fix))
  printChoice(after)
  printMaybe(after)
  if (written) printBlanks(written, policyBlanks(written))
  printOwnerSteps(after)
  for (const n of [...bootNotes(after), ...ranNotes]) console.log(`\nNote: ${n}`)
  console.log(`\n${failed ? `${failed} ${failed === 1 ? 'step' : 'steps'} failed. ` : ''}Safe to run again: steps already done are skipped. winston doctor shows what is left.`)
  return failed ? 1 : 0
}

function init(cwd, opts) {
  const sit = situation(cwd)
  if (!opts.mode) {
    ask(sit)
    if (opts.yes) console.error('\nwinston init --yes needs --mode: the setup is the owner\'s choice, not a guess.')
    return opts.yes ? 2 : 0
  }
  if (!MODES.includes(opts.mode)) {
    console.error(`winston init: --mode is one of ${MODES.join(', ')}`)
    return 2
  }
  if (opts.triage !== undefined && !TRIAGE_CHOICES.includes(opts.triage)) {
    console.error(`winston init: --triage is one of ${TRIAGE_CHOICES.join(', ')}`)
    return 2
  }
  return opts.mode === 'join' ? join_(cwd, sit, opts.yes) : setup(cwd, sit, opts)
}

const INIT_FLAGS = { '--yes': false, '--public': false, '--mode': true, '--triage': true, '--board': true, '--integration': true, '--owner': true, '--repo': true }

/** Strict: an unknown flag, or a flag missing its value, is an error, never a guess. */
function initOptions(args) {
  const opts = {}
  for (let i = 0; i < args.length; i++) {
    const flag = args[i]
    if (!(flag in INIT_FLAGS)) throw new Error(`winston init: unknown argument ${flag}`)
    if (!INIT_FLAGS[flag]) opts[flag.slice(2)] = true
    else {
      const value = args[++i]
      if (value === undefined || value.startsWith('--')) throw new Error(`winston init: ${flag} needs a value`)
      opts[flag.slice(2)] = value
    }
  }
  return opts
}

const PERMISSION_FLAGS = { '--apply': false, '--add': true }

function permissionOptions(args) {
  const opts = { add: [] }
  for (let i = 0; i < args.length; i++) {
    const flag = args[i]
    if (!(flag in PERMISSION_FLAGS)) throw new Error(`winston permissions: unknown argument ${flag}`)
    if (!PERMISSION_FLAGS[flag]) opts.apply = true
    else {
      const value = args[++i]
      if (value === undefined || value.startsWith('--')) throw new Error(`winston permissions: ${flag} needs a value`)
      opts.add.push(value)
    }
  }
  return opts
}

function installCodexAgents(force) {
  const agents = codexSources()
  if (!agents.length) {
    console.log('No Codex agents in this plugin (codex/agents/*.toml).')
    return 0
  }
  let refused = 0
  for (const a of agents) {
    const want = readFileSync(a.src, 'utf8')
    const have = existsSync(a.dst) ? readFileSync(a.dst, 'utf8') : null
    if (have === want) {
      console.log(`same      ${a.dst}`)
      continue
    }
    if (have !== null && !force) {
      refused++
      console.log(`differs   ${a.dst} — not overwritten (rerun with --force to replace it)`)
      continue
    }
    mkdirSync(dirname(a.dst), { recursive: true })
    writeFileSync(a.dst, want)
    console.log(`${have === null ? 'installed' : 'replaced '} ${a.dst}`)
  }
  return refused ? 1 : 0
}

function config(cwd, json) {
  const layers = loadLayers(cwd)
  const merged = { ...layers.user.data, ...layers.repo.data }
  if (json) {
    console.log(JSON.stringify(merged, null, 2))
    return 0
  }
  for (const [name, l] of [['user', layers.user], ['repo', layers.repo]]) {
    console.log(`${name} layer: ${l.path ?? '(not in a git repository)'}${l.path ? (l.loaded ? '' : ' (not found)') : ''}`)
  }
  console.log(JSON.stringify(merged, null, 2))
  return 0
}

const USAGE = 'usage: winston config [--json] | doctor [--copy] | init [--mode join|new|adopt] [--yes] | permissions [--apply] [--add <rule>] | install-codex-agents [--force] | title <words...>'

function main(argv) {
  const [cmd, ...rest] = argv
  const cwd = process.cwd()
  try {
    switch (cmd) {
      case 'config': return config(cwd, rest.includes('--json'))
      case 'doctor':
        if (rest.some((a) => a !== '--copy')) throw new Error(`winston doctor: unknown argument ${rest.find((a) => a !== '--copy')}`)
        return doctor(cwd, rest.includes('--copy'))
      case 'init': return init(cwd, initOptions(rest))
      case 'permissions': return permissions(cwd, permissionOptions(rest))
      case 'install-codex-agents': return installCodexAgents(rest.includes('--force'))
      case 'title':
        if (!recordTitle(rest)) {
          console.error(`winston title: needs words and a Claude Code session (CLAUDE_CODE_SESSION_ID)`)
          return 1
        }
        return 0
      default:
        console.error(USAGE)
        return 2
    }
  } catch (e) {
    console.error(e.message)
    return 1
  }
}

if (import.meta.main) process.exitCode = main(process.argv.slice(2))
