  { role: 0, name: 'New', color: 'BLUE', description: 'New issues, waiting to be looked at.' },
  { role: 1, name: 'Ready', color: 'GREEN', description: 'Looked at and approved. Ready to build.' },
  { name: 'In Progress', color: 'YELLOW', description: 'Being worked on now.' },
  { role: 2, name: 'Verify', color: 'RED', description: 'Built and on staging. Ready to be checked.' },
  { role: 3, name: 'Verified', color: 'GRAY', description: 'Checked on staging. Ready to release.' },
  { name: 'Done', color: 'PURPLE', description: 'Released.' },
]
const columns = (statuses = DEFAULT_STATUSES) => COLUMNS.map(({ role, ...c }) => ({ ...c, name: role === undefined ? c.name : statuses[role] ?? c.name }))
