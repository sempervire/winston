/**
 * The plain word for a check: done, needs you, could not check, after setup (it follows
 * from the setup init does), tip, or on/off for an optional tool.
 */
export function statusOf(c) {
  if (c.state === 'ok') return 'done'
  if (c.state === 'unknown') return 'could not check'
  if (c.state === 'later') return 'after setup'
  if (c.tip) return 'tip'
  if (c.state === 'on' || (c.state === 'off' && !c.problem && !c.steps && !c.ownerStep)) return c.state
  return 'needs you'
}

/** The slash command first, then the same step as a winston command typed in the chat. */
const INIT_LINE = `${useSkill('init')[0].toUpperCase()}${useSkill('init').slice(1)}. It shows its plan and changes nothing until you say yes`
/** The one paste-ready text for "run /winston:init": only Claude Code has a slash command to paste. */
const INIT_COMMAND = HARNESS === 'claude' ? '/winston:init' : undefined

/** Single-quote a path for a shell, escaping any quote inside it. */
const shq = (v) => `'${String(v).replace(/'/g, `'\\''`)}'`

/**
 * One command that puts files on the default branch, whatever branch is checked out and
 * whatever local edits exist: it builds the commit in a temporary worktree cut from the
 * remote default branch, so the user's own checkout is never switched or touched, and
 * the pull request holds only these files. With `remove`, the files are deleted there
 * instead of copied. It starts with a cd into the repository and a fetch.
 */
function landOnDefault(paths, message, production, remove = false, removed = []) {
  const root = repoRoot(process.cwd()) ?? process.cwd()
  const rel = (list) => list.map((p) => (isAbsolute(p) ? relative(root, p) : p)).filter((p) => p && !p.startsWith('..'))
  const [copy, gone] = remove ? [[], rel(paths)] : [rel(paths), rel(removed)]
  const prod = production ? shq(production) : '"$(git symbolic-ref --short refs/remotes/origin/HEAD | cut -d/ -f2-)"'
  const branch = `winston-setup-${Date.now().toString(36)}`
  const apply = [
    ...(copy.length ? [`for f in ${copy.map(shq).join(' ')}; do mkdir -p "$T/w/$(dirname "$f")" && cp "$f" "$T/w/$f" || exit 1; done`] : []),
    ...(gone.length ? [`git -C "$T/w" rm -q -- ${gone.map(shq).join(' ')}`] : []),
  ].join(' && ')
  // The worktree is removed whatever happened, and the command still fails when a step did,
  // so a PR that was never opened never reads as done.
  return `cd ${shq(root)} && git fetch origin && P=${prod} && T=$(mktemp -d) && { (git worktree add -b ${branch} "$T/w" "origin/$P" && ${apply} && git -C "$T/w" add -A && git -C "$T/w" commit -m ${shq(message)} && git -C "$T/w" push -u origin ${branch} && cd "$T/w" && gh pr create --base "$P" --fill); s=$?; git worktree remove --force "$T/w"; rmdir "$T"; test $s -eq 0; }`
}

/** How to close an open item: { command } for one paste-ready command, and the lines to show. */
function fixOf(c) {
  if (c.steps) {
    const lines = c.steps()
    return { lines, ...lines.next }
  }
  if (c.ownerStep) return { command: HARNESS === 'codex' ? undefined : '!winston permissions --apply', how: inChat('winston permissions --apply'), lines: [`${RULES_WHY_YOU}: ${inChat('winston permissions --apply')}`] }
  if (c.command || c.fixLines) return { command: c.command, lines: c.fixLines }
  if (c.unconfigured) return { command: INIT_COMMAND, how: useSkill('init'), lines: [INIT_LINE] }
  if (c.fix) return { command: INIT_COMMAND, how: useSkill('init'), lines: [`${INIT_LINE}. It will: ${c.fix.plan}`] }
  if (c.browser) return { lines: [`Next: ${useSkill('init')} and it does this for you in the browser. To do it yourself: ${c.hand}`] }
  return { lines: [c.problem || c.hand || c.detail] }
}

/** The steps no API call can take: those done on a web page, then the rest. */
function printSteps(items) {
  const browser = items.filter((c) => c.browser)
  const hand = items.filter((c) => !c.browser)
  if (browser.length) {
    console.log('\nIn the browser (GitHub has no API for these; /winston:init does them through Claude in Chrome, or do them yourself):')
    for (const c of browser) console.log(`  - ${c.name}: ${c.hand}`)
  }
  if (hand.length) {
    console.log('\nBy hand (each line says what to do next):')
    for (const c of hand) console.log(`  - ${c.name}: ${c.hand || c.detail}`)
  }
}

/**
 * Browser checks doctor could not confirm either way (state `unknown`, e.g. no issues yet
 * to read a timeline from, #45): never required, never performed automatically, but still
 * worth the owner's or agent's knowledge that the step exists, in case it is genuinely off.
 */
function printMaybe(list) {
  const maybe = list.filter((c) => c.browser && c.state === 'unknown')
  if (!maybe.length) return
  console.log('\nCould not confirm (may already be on; optional, in the browser):')
  for (const c of maybe) console.log(`  - ${c.name}: ${c.hand}`)
}

/**
 * The installed version against the latest. The answer comes from the update check's
 * cache, so GitHub is asked at most once a day (once an hour after a failed lookup).
 * Never a required check: a stale Winston still works.
 */
function versionCheck(cwd) {
  const have = installedVersion()
  const asked = run(process.execPath, [join(ROOT, 'lib', 'update.mjs')], { timeout: 8000 })
  let latest = null
  try {
    latest = JSON.parse(asked.out).latest
  } catch {}
  const base = { name: 'Winston version', required: false, scope: 'you' }
  if (!latest) return { ...base, state: 'unknown', detail: `${have} installed; could not reach GitHub to check for a newer one` }
  if (!newer(latest, have)) return { ...base, state: 'ok', detail: `${have}, the latest` }
  const harness = harnessOfRoot(ROOT)
  const claude = updateSteps('claude', installScope(cwd))
  const codex = updateSteps('codex')
  const restart = 'Winston never updates itself: an update replaces hooks and skills and needs a restart.'
  const out = { ...base, state: 'off', detail: `${have} installed, ${latest} available`, problem: `update to ${latest}` }
  if (harness) {
    // Codex's update is two commands; the one command offered as the next step runs both.
    const command = harness === 'codex' ? [...codex.matchAll(/`([^`]+)`/g)].map((m) => m[1]).join(' && ') : claude.match(/`([^`]+)`/)?.[1]
    return { ...out, command, fixLines: [`To update, ${harness === 'codex' ? codex : claude}.`, restart] }
  }
  // Cannot tell which app installed this copy: show both, and leave `command` unset so the
  // "Next step" line points at these lines rather than naming one app's command.
  return {
    ...out,
    fixLines: ['To update, follow the line for the app you use Winston in:', `  Claude Code: ${claude}.`, `  Codex: ${codex}.`, restart],
  }
}

/**
 * The checklist: every check with a plain status, then each open item with why it
 * matters and how to close it, then one "Next step:" line naming the first. Read-only,
 * apart from Winston's own state directory: the result is kept there for the
 * session-start nudge, and the version check keeps its answer there.
 */
function doctor(cwd, copy = false) {
  const list = checks(cwd)
  const version = versionCheck(cwd)
  const at = list.findIndex((c) => c.optional)
  if (version) list.splice(at === -1 ? list.length : at, 0, { detail: '', ...version })
  const root = repoRoot(cwd)
  console.log(`Winston setup checklist${root ? ` for ${basename(root)}` : ''}. Safe to run again: it only reads.\n`)
  if (HARNESS_LEGEND) console.log(HARNESS_LEGEND)
  for (const c of list) console.log(`${statusOf(c).padEnd(16)} ${c.name}${c.detail ? `  — ${c.detail}` : ''}`)

  // A repo with no config has one thing to do; the rest follows from it.
  const all = list.filter((c) => statusOf(c) === 'needs you')
  const open = all.some((c) => c.unconfigured) ? all.filter((c) => c.unconfigured || c.scope === 'you') : all
  const blind = list.filter((c) => statusOf(c) === 'could not check')
  if (root) {
    try {
      const file = doctorResultPath(root)
      mkdirSync(dirname(file), { recursive: true })
      writeFileSync(file, JSON.stringify({ root, open: open.length, first: open[0]?.name ?? null, at: new Date().toISOString() }))
    } catch {}
  }
  const code = missing(list).length ? 1 : 0
  const extras = () => {
    const tips = list.filter((c) => statusOf(c) === 'tip')
    const off = list.filter((c) => c.optional && c.state === 'off' && c.turnOn)
    if (tips.length) {
      console.log('\nTips (nothing is wrong; these make Winston fit this project better):')
      for (const c of tips) console.log(`  - ${c.problem}`)
    }
    if (off.length) {
      console.log('\nOptional extras (off now; not needed for setup):')
      for (const c of off) console.log(`  - ${c.name}: ${c.turnOn}`)
    }
  }
  if (!open.length) {
    if (copy) console.log('\nNothing was copied: there is no next step.')
    extras()
    console.log(`\nSetup is complete: nothing needs you.${blind.length ? ` ${blind.length} ${blind.length === 1 ? 'line says' : 'lines say'} "could not check": this account or network could not see ${blind.length === 1 ? 'it' : 'them'}, which is usually fine; each line says what to look at if you want to be sure.` : ''}`)
    return code
  }
  console.log(`\nNeeds you (${open.length}):`)
  const fixes = open.map(fixOf)
  for (const [i, c] of open.entries()) {
    console.log(`\n${i + 1}. ${c.name}`)
    const why = WHY.find(([re]) => re.test(c.name))?.[1]
    if (why) console.log(`   Why: ${why}`)
    console.log('   Fix:')
    for (const line of fixes[i].lines) console.log(`     ${line}`)
  }
  const { open: link } = fixes[0]
  const command = fixes[0].command ?? link
  let copied = ''
  if (copy) {
    const done = command && process.platform === 'darwin' && spawnSync('pbcopy', { input: command }).status === 0
    if (done) copied = '   (copied to the clipboard)'
    else console.log(`\nNothing was copied: ${!command ? 'the next step is several steps, not one command' : process.platform !== 'darwin' ? '--copy works on macOS only' : 'pbcopy did not run'}.`)
  }
  extras()
  // Winston's own steps say where they are typed (fixOf's `how`); any other command goes in the Terminal app.
  const how = fixes[0].how ?? (command && `in the Terminal app, run: ${command}`)
  console.log(`\nNext step: ${open[0].name} – ${link ? `open ${link}${copied} and follow the steps under 1 above` : how ? `${how}${copied}` : 'follow the steps under 1 above'}. Then run /winston:doctor again.`)
  return code
}

/** What this directory is, read-only: the facts the three setups differ on. */
function situation(cwd) {
  const root = repoRoot(cwd)
  const git = (...args) => run('git', ['-C', root, ...args])
  const hasConfig = !!root && existsSync(join(root, '.winston', 'config.json'))
  const hasCommits = !!root && git('rev-parse', '--verify', '-q', 'HEAD').ok
  const origin = (root && git('remote', 'get-url', 'origin').out) || null
  let mode, why
  if (hasConfig) [mode, why] = ['join', 'Winston\'s settings are already in this project']
  else if (!root) [mode, why] = ['new', 'this folder does not use git yet']
  else if (!hasCommits) [mode, why] = ['new', 'this project has no saved history yet']
  else if (!origin) [mode, why] = ['new', 'this project is not on GitHub yet']
  else [mode, why] = ['adopt', 'this project is on GitHub and Winston has not been set up in it']
  // The one case detection can get wrong: history and no GitHub address may be a project
  // that is on GitHub, in a copy that lost its link. `new` would make a second repository.
  const ambiguous = mode === 'new' && hasCommits && !origin
  // A git repository at the home folder (or a standard folder) is still no place for a
  // new project; a repository that holds others (submodules, a monorepo) can be one.
  const unsuitable = root ? (hasConfig ? null : unsuitableFolder(root, { nested: false })) : unsuitableFolder(cwd)
  return { root, hasConfig, hasCommits, origin, mode, why, ambiguous, unsuitable }
}

/** What each setup does, in a line a person reads before the plan. */
const MODE_LEAD = {
  join: 'This project is already set up for Winston, so Winston only checks your access and this computer. Nothing in the project or on GitHub changes.',
  new: 'This is a new project, so Winston sets everything up.',
  adopt: 'This is an existing project Winston hasn\'t set up yet, so Winston adds only what is missing. Nothing you already have is renamed or removed.',
}

/** init with no --mode: say what this folder looks like, in plain words, before its plan. */
function intro(sit) {
  console.log(`Setup: ${sit.mode}, because ${sit.why}. ${MODE_LEAD[sit.mode]}`)
  if (sit.ambiguous) {
    console.log('\nCheck first: if this project is already on GitHub, connect this copy to it instead of making a second one.')
    console.log(`${IN_TERMINAL}, in this folder, run: git remote add origin <the project's GitHub address>, then run /winston:init again. If it is not on GitHub yet, go ahead with the plan below.`)
  }
  // Only the setups that can apply here: join needs Winston's settings, adopt a project
  // with history on GitHub (or settings to fill gaps from), new a folder with no settings.
  const fits = { join: sit.hasConfig, adopt: sit.hasConfig || (!!sit.root && sit.hasCommits && !!sit.origin), new: !sit.hasConfig }
  const others = MODES.filter((m) => m !== sit.mode && fits[m])
  if (others.length) console.log(`To choose a different setup, ${inChat(`winston init --mode ${others.join(' (or --mode ')}${others.length > 1 ? ')' : ''}`)}`)
  console.log('')
}

/** join: the repo's setup is someone else's. Report; write nothing outside this machine. */
function join_(cwd, sit, yes) {
  if (!sit.hasConfig) {
    console.log('Winston isn\'t set up in this copy of the project yet.')
    console.log('If a teammate set it up, get their settings: in the Terminal app, in this folder, run: git pull   (ask them which branch if that does not bring in .winston/config.json).')
    console.log('If no one has set it up, run /winston:init and Winston will set it up for you.')
    return 1
  }
  const list = checks(cwd)
  const layers = loadLayers(cwd)
  const owner = { ...layers.user.data, ...layers.repo.data }.owner || 'the owner'
  const bad = missing(list)
  const yours = bad.filter((c) => c.scope === 'you')
  const theirs = bad.filter((c) => c.scope !== 'you')
  console.log(`Joining ${basename(sit.root)}. Its setup is ${owner}'s: nothing in the project or on GitHub is changed.`)
  if (!bad.length) console.log('\nReady: everything Winston needs is in place.')
  if (yours.length) {
    console.log('\nYours to fix:')
    for (const c of yours) console.log(`  - ${c.name}: ${c.hand || c.detail}`)
  }
  if (theirs.length) {
    console.log(`\nGaps in the project's own setup. They are ${owner}'s to close, not yours: send them this list, and they can run /winston:init to fix it:`)
    for (const c of theirs) console.log(`  - ${c.name}${c.detail ? ` — ${c.detail}` : ''}`)
  }
  // The launchers read launcher.repo from the user layer only, so the repo's copy never
  // reaches a second person. Set it when they have none; never replace one.
  const userPath = join(winstonHome(), 'config.json')
  if (!layers.user.data.launcher?.repo) {
    const shown = sit.root.startsWith(homedir() + '/') ? `~${sit.root.slice(homedir().length)}` : sit.root
    const plan = `set launcher.repo to ${shown} in ${userPath} (the session launchers open that checkout)`
    if (!yes) {
      console.log(`\nOn this computer, init would:\n  - ${plan}\n\nNothing has changed yet. To go ahead, ${inChat('winston init --mode join --yes')}`)
    } else {
      mkdirSync(dirname(userPath), { recursive: true })
      writeFileSync(userPath, JSON.stringify({ ...layers.user.data, launcher: { ...layers.user.data.launcher, repo: shown } }, null, 2) + '\n')
      console.log(`\ndone     ${plan}`)
    }
  }
  return yours.length ? 1 : 0
}

/**
 * The first steps for a repo with no config: settle the GitHub repo, the two branches and
 * the board, then write a config that describes them. Read-only until a step's run().
 * Returns { steps, notes, planned } or { boards } when the owner must pick a board.
 */
function bootstrap(cwd, sit, opts) {
  const root = sit.root ?? cwd
  const git = (...args) => run('git', ['-C', root, ...args])
  const login = run('gh', ['api', 'user', '--jq', '.login']).out
  if (!login) {
    throw new Error(onPath('gh')
      ? 'Winston can\'t reach GitHub: the GitHub command-line tool (gh) is not signed in. In the Terminal app, run: gh auth login, then: gh auth refresh -s project. Then run /winston:init again.'
      : 'Winston can\'t reach GitHub: the GitHub command-line tool (gh) is not installed. In the Terminal app, run: brew install gh   (or get it from https://cli.github.com), then: gh auth login, then: gh auth refresh -s project. Then run /winston:init again.')
  }

  const noRepo = !sit.origin
  let slug
  if (noRepo) slug = opts.repo || `${login}/${basename(root)}`
  else {
    const view = run('gh', ['repo', 'view', '--json', 'nameWithOwner', '--jq', '.nameWithOwner'], { cwd: root })
    if (!view.ok) {
      const named = /github\.com[:/]+([^/\s]+\/[^/\s]+?)(?:\.git)?\/?$/.exec(sit.origin)?.[1] ?? sit.origin
      throw new Error([
        `GitHub can't find ${named}, the project this folder is linked to. One of two things is usually the cause:`,
        `  - You're signed in to a different GitHub account. Check: in the Terminal app, run: gh auth status   (to switch: gh auth login)`,
        `  - The project's GitHub address is wrong, or the project was renamed or deleted. Check: in the Terminal app, in this folder, run: git remote -v`,
        'Then run /winston:init again.',
      ].join('\n'))
    }
    slug = view.out
  }
  const [ghOwner, name] = slug.split('/')
  if (!ghOwner || !name) throw new Error(`--repo takes <owner>/<name>, got: ${slug}`)

  // Branches: production is what the repo already treats as its default.
  let production, heads = []
  if (noRepo) production = (sit.root && git('symbolic-ref', '--short', 'HEAD').out) || 'main'
  else {
    heads = git('ls-remote', '--heads', 'origin').out.split('\n').map((l) => l.split('refs/heads/')[1]).filter(Boolean)
    production = git('ls-remote', '--symref', 'origin', 'HEAD').out.match(/^ref: refs\/heads\/(\S+)\s+HEAD/m)?.[1]
    if (!production) throw new Error(`GitHub did not say which branch this project releases from. Usually that means the GitHub repository is empty: push your work to it first (in the Terminal app, in this folder, run: git push -u origin HEAD), then run /winston:init again.`)
  }
  const integration = opts.integration || INTEGRATION_NAMES.find((b) => b !== production && heads.includes(b)) || 'staging'

  // Board: an existing one is used as it stands; only a new project gets created.
  let board = null
  if (opts.board && opts.board !== 'new') {
    const [owner, number] = opts.board.split('/')
    if (!owner || !/^\d+$/.test(number ?? '')) throw new Error(`--board takes <owner>/<number> or new, got: ${opts.board}`)
    board = { owner, number: Number(number) }
    if (!fetchBoard(owner, board.number).project) throw new Error(`--board ${opts.board}: this GitHub account cannot open that board. Check the owner and number in the board's web address (github.com/users/<owner>/projects/<number>), or ask its owner to give you access.`)
  } else if (!opts.board && !noRepo) {
    const linked = run('gh', ['api', 'graphql', '-f', `query=${LINKED_BOARDS_QUERY}`, '-f', `owner=${ghOwner}`, '-f', `name=${name}`])
    let nodes = []
    try {
      nodes = JSON.parse(linked.out).data.repository.projectsV2.nodes.filter((n) => n && !n.closed)
    } catch {
      throw new Error(`GitHub would not list the boards linked to ${slug} for this account (${linked.err || linked.out}). Check you are signed in to the right account: in the Terminal app, run: gh auth status   (gh auth refresh -s project adds board access), then run /winston:init again.`)
    }
    if (nodes.length > 1) {
      const boards = nodes.map((n) => ({ owner: n.owner.login, number: n.number, title: n.title }))
      // The recommended board: the one named like the repository, else the first GitHub lists.
      const pick = boards.find((b) => b.title?.trim().toLowerCase() === name.toLowerCase()) ?? boards[0]
      return { boards: [pick, ...boards.filter((b) => b !== pick)], why: pick.title?.trim().toLowerCase() === name.toLowerCase() ? 'its name matches this project' : 'GitHub lists it first' }
    }
    if (nodes.length === 1) board = { owner: nodes[0].owner.login, number: nodes[0].number }
  }
  const newBoard = !board
  const statuses = DEFAULT_STATUSES

  const present = (f) => existsSync(join(root, f))
  const processDocs = PROCESS_DOCS.filter(present)
  const config = {
    owner: opts.owner || (sit.root && git('config', 'user.name').out) || login,
    branches: { integration, production },
    board: { owner: board?.owner ?? ghOwner, number: board?.number ?? null, statuses, priorityField: 'Priority' },
    processDocs,
    // The first doc that already holds triage rules; otherwise the starter init writes.
    triage: { policy: [DEFAULT_POLICY, ...processDocs].find((f) => policyState(join(root, f)) === 'ok') ?? DEFAULT_POLICY, workflow: DEFAULT_TRIAGE_WORKFLOW, labels: [] },
    // Every repo gets the gate: a merge into production waits for the owner's phrase. It
    // costs nothing where merges do not deploy and is the safe default where they do.
    deployGate: { phrase: DEPLOY_PHRASE, guarded: [{ kind: 'pr-merge', base: production }] },
    worktree: { copy: ['.env.local', '.env'].filter(present), link: present('package.json') ? ['node_modules'] : [] },
  }
  const configPath = join(root, '.winston', 'config.json')
  const wf = join(root, '.github', 'workflows', DEFAULT_TRIAGE_WORKFLOW)
  const must = (r, what) => { if (!r.ok) throw new Error(`${what}: ${r.err || r.out}`) }
  const shown = (p) => shownPath(root, p)

  const steps = []
  if (!sit.root) steps.push({ plan: `Start keeping versions of this folder with git (git init, on branch ${production})`, run: () => must(run('git', ['init', '-q', '-b', production, root]), 'git init') })
  // A new project's own workflows point at its default options: "Item added to project" at
  // Todo, and the closing ones at Done. Each stock option is kept by id under the column
  // that takes its place, so Todo becomes the intake column and that workflow sets it.
  const configureNewBoard = () => {
    const status = fetchBoard(ghOwner, config.board.number).project?.fields.nodes.find((f) => f?.name === 'Status')
    if (!status?.id) throw new Error('cannot read the new project\'s Status field')
    const stock = (n) => status.options.find((o) => o.name === n)?.id
    setOptions(status.id, columns(statuses).map((c, i) => ({ ...c, id: stock(i === 0 ? 'Todo' : c.name) })))
    createPriorityField(ghOwner, config.board.number, 'Priority')
    for (const name of DATE_FIELDS) createDateField(ghOwner, config.board.number, name)
  }
  if (newBoard) {
    steps.push({
      plan: `Make a private board, "${name}", where your work is tracked: columns ${columns(statuses).map((c) => c.name).join(' / ')}, a Priority field (${PRIORITIES.join(', ')}) and Start and Target dates (a GitHub Project under ${ghOwner})`,
      run: () => {
        const made = run('gh', ['project', 'create', '--owner', ghOwner, '--title', name, '--format', 'json'])
        must(made, 'gh project create')
        config.board.number = JSON.parse(made.out).number
        try {
          configureNewBoard()
        } catch (e) {
          // The project exists and is not linked yet, so a plain rerun would not find it.
          throw new Error(`${e.message}. ${ghOwner} project ${config.board.number} was created: rerun with --board ${ghOwner}/${config.board.number} to use it rather than make another`)
        }
      },
    })
  }
  steps.push({
    plan: `Save Winston's settings for this project (${shown(configPath)}): releases from ${production}, work lands on ${integration} first, uses ${newBoard ? 'the new board' : `board #${board.number} (${board.owner})`}${processDocs.length ? `, follows ${processDocs.join(', ')}` : ''}. Merging into ${production} will need you to type "${DEPLOY_PHRASE}" in the session first`,
    run: () => { mkdirSync(dirname(configPath), { recursive: true }); writeFileSync(configPath, JSON.stringify(config, null, 2) + '\n') },
  })
  if (!sit.hasCommits) {
    steps.push({
      plan: 'Save the first version of the project: Winston\'s settings and the automatic-triage workflow, nothing else',
      run: () => {
        writeTriageWorkflow(wf)
        must(git('add', '--', configPath, wf), 'git add')
        must(git('commit', '-q', '-m', 'Add Winston configuration', '--', configPath, wf), 'git commit')
      },
    })
  }
  if (noRepo) {
    steps.push({
      plan: `Put the project on GitHub as ${opts.public ? 'a public' : 'a private'} repository, ${slug}, and upload ${production}`,
      run: () => must(run('gh', ['repo', 'create', slug, opts.public ? '--public' : '--private', '--source', root, '--remote', 'origin', '--push'], { timeout: PUSH_TIMEOUT }), 'gh repo create'),
    })
  }
  if (integration !== production && !heads.includes(integration)) {
    steps.push({
      plan: `Make the work branch, ${integration}, on GitHub (a copy of ${production} where finished work waits to be checked)`,
      run: () => createBranch(root, integration, production),
    })
  }
  if (newBoard) {
    steps.push({
      plan: `Link the new board to ${slug}`,
      run: () => must(run('gh', ['project', 'link', String(config.board.number), '--owner', ghOwner, '--repo', name]), 'gh project link'),
    })
  }

  const notes = []
  // The files init writes into an existing repo, for the one note that lands them on the default branch.
  if (sit.hasCommits) notes.push({ commit: { withWorkflow: [configPath, wf], without: [configPath] } })
  return { steps, notes, planned: { config, newBoard, noRepo, firstCommit: !sit.hasCommits, slug } }
}

/** new and adopt: build what is missing. With a config already here, that config is the plan. */
function setup(cwd, sit, opts) {
  if (opts.mode === 'adopt' && !sit.hasConfig && !(sit.root && sit.hasCommits && sit.origin)) {
    console.log(`adopt is for a project that already has saved history and is on GitHub, and ${sit.why}. For a new project, ${useSkill('init')}: it picks the right setup`)
    return 1
  }
  const boot = sit.hasConfig ? null : bootstrap(cwd, sit, opts)
  if (boot?.boards) {
    const [pick, ...rest] = boot.boards
    console.log('This project is linked to more than one GitHub board. Winston uses one of them to track the work.')
    console.log(`  Recommended: --board ${pick.owner}/${pick.number}   ${pick.title}   (${boot.why})`)
    for (const b of rest) console.log(`  --board ${b.owner}/${b.number}   ${b.title}`)
    console.log('  --board new   make a new board instead')
    console.log(`\nNothing has changed yet. To plan with the recommended board, ${applyCommand({ ...opts, board: `${pick.owner}/${pick.number}`, yes: false })}`)
    return opts.yes ? 2 : 0
  }
  const list = checks(cwd, boot?.planned, true, opts.triage)
  // What init does: every required gap it can close, the owner's answered choices, and the
  // offers (an agent-based or stale-pinned triage workflow) shown here before --yes applies them.
  const fixable = (l) => l.filter((c) => c.fix && ((c.required && c.state === 'missing') || c.conflict || c.offer))
  const fixes = fixable(list)
  const hand = missing(list).filter((c) => !c.fix)
  const printHand = printSteps
  // Winston's triage workflow is not written while another one waits on the owner's choice, or is kept.
  const production = (boot?.planned?.config ?? (() => { const l = loadLayers(cwd); return { ...l.user.data, ...l.repo.data } })()).branches?.production
  // One note for every file that works only once it is on the default branch, with one
  // command that lands them all; any other note after it. Winston's triage workflow is
  // not among them while another one waits on the owner's choice, or is kept.
  const printNotes = (l, done) => {
    const held = l.some((c) => c.conflict && (!c.fix || opts.triage === 'keep'))
    const paths = [...new Set([
      ...(boot?.notes ?? []).flatMap((n) => (held ? n.commit.without : n.commit.withWorkflow)),
      ...done.flatMap((f) => f.commit ?? []),
    ])]
    const removed = [...new Set(done.flatMap((f) => f.removed ?? []))]
    if (paths.length || removed.length) {
      const root = repoRoot(cwd) ?? cwd
      const list = (l) => l.map((f) => shownPath(root, f)).join(', ')
      const what = [paths.length && `These files only start working once they are saved to ${production ?? 'the default branch'} on GitHub (GitHub runs workflows, and reads the settings they use, from there only): ${list(paths)}.`, removed.length && `${list(removed)} ${removed.length === 1 ? 'keeps' : 'keep'} running on every new issue until ${removed.length === 1 ? 'its' : 'their'} deletion is saved there too.`].filter(Boolean).join(' ')
      console.log(`\nNote: ${what} Next: /winston:init asks in a question box (recommended: yes) and does this for you, or from any branch run: ${landOnDefault(paths, 'Set up Winston', production, false, removed)}`)
    }
    for (const n of done.filter((f) => f.note && !f.commit).map((f) => f.note)) console.log(`\nNote: ${n}`)
  }
  // A second triage workflow is the owner's choice, never a guess: asked until answered.
  const printChoice = (l) => {
    const c = l.find((x) => x.conflict && !x.fix)
    if (!c) return
    console.log(`\nTriage workflow, your choice (one answer deletes a file): ${c.detail}, and Winston's would too. Run init again with one of:`)
    for (const [flag, plan] of Object.entries(c.conflict.plans)) console.log(`  --triage ${flag.padEnd(8)} ${flag === 'replace' ? '(Recommended) ' : ''}${plan}`)
    console.log(`Until you choose, init leaves the triage workflows as they are. Recommended: ${applyCommand({ ...opts, triage: 'replace', yes: false })}`)
  }
  if (!boot && !fixes.length && !hand.length) {
    console.log(`${ownerSteps(list) ? 'Winston\'s part of the setup is done' : 'Nothing to do: the setup is complete'}. Nothing was changed. Safe to run again.`)
    printChoice(list)
    printMaybe(list)
    printOwnerSteps(list)
    return 0
  }
  const plans = [...(boot?.steps ?? []), ...fixes.map((c) => c.fix)]
  if (!opts.yes) {
    if (plans.length) {
      console.log(`${opts.detected ? '' : `${MODE_LEAD[opts.mode]}\n\n`}Winston will:`)
      for (const p of plans) console.log(`  - ${p.plan}`)
    }
    printHand(hand)
    printChoice(list)
    printMaybe(list)
    printOwnerSteps(list)
    printNotes(list, fixes.map((c) => c.fix))
    if (plans.length) console.log(`\nNothing has changed yet. To go ahead, ${applyCommand({ ...opts, yes: true })}   (safe to run again: steps already done are skipped, and nothing existing is overwritten)`)
    return 0
  }

  // First steps run in order and each needs the one before it, so the first failure stops.
  const first = boot?.steps ?? []
  for (const [i, step] of first.entries()) {
    try {
      step.run()
      console.log(`done     ${step.plan}`)
    } catch (e) {
      console.log(`failed   ${step.plan}: ${e.message}`)
      for (const later of first.slice(i + 1)) console.log(`not run  ${later.plan}`)
      return 1
    }
  }
  // The config exists now, so the checks read the real repo and board.
  const after = boot ? checks(cwd, null, true, opts.triage) : list
  let failed = 0
  let written = null
  const ran = []
  for (const c of fixable(after)) {
    try {
      c.fix.run()
      ran.push(c.fix)
      if (c.fix.starter) written = c.fix.starter
      console.log(`done     ${c.fix.plan}`)
    } catch (e) {
      failed++
      console.log(`failed   ${c.fix.plan}: ${e.message}`)
    }
  }
  printHand(missing(after).filter((c) => !c.fix))
  printChoice(after)
  printMaybe(after)
  if (written) printBlanks(written, policyBlanks(written))
  printOwnerSteps(after)
  printNotes(after, ran)
  console.log(`\n${failed ? `${failed} ${failed === 1 ? 'step' : 'steps'} failed; running it again retries only what is left. ` : ''}Next: /winston:doctor to see what's left.`)
  return failed ? 1 : 0
}

/** The init command that plans or applies exactly what this run planned, flags and all. */
function applyCommand(opts) {
  // Single quotes, so nothing in a value (a $, a backtick) is expanded by the shell.
  const flags = ['mode', 'board', 'integration', 'owner', 'repo', 'triage'].filter((k) => opts[k] !== undefined).map((k) => `--${k} ${/^[\w./@:+-]+$/.test(opts[k]) ? opts[k] : shq(opts[k])}`)
  return inChat(['winston init', ...flags, ...(opts.public ? ['--public'] : []), ...(opts.yes ? ['--yes'] : [])].join(' '))
}

function init(cwd, opts) {
  const sit = situation(cwd)
  if (HARNESS_LEGEND) console.log(HARNESS_LEGEND)
  // A folder outside git that is no project (the home folder, a folder of projects) is
  // never planned as a new one: say where to go instead.
  if (sit.unsuitable && opts.mode !== 'join') {
    console.log(`${WRONG_FOLDER}\n(Winston did not use ${cwd}: ${sit.unsuitable}.)${sit.root ? '' : folderWayOut(cwd, sit.unsuitable).replace(/^ /, '\n')}`)
    return 1
  }
  if (!opts.mode) {
    if (opts.yes) {
      console.error(`winston init --yes applies the plan you saw, so it needs the setup named: ${applyCommand({ ...opts, mode: sit.mode })}`)
      return 2
    }
    intro(sit)
    opts = { ...opts, mode: sit.mode, detected: true }
  }
  if (!MODES.includes(opts.mode)) {
    console.error(`winston init: --mode is one of ${MODES.join(', ')}`)
    return 2
  }
  if (opts.triage !== undefined && !TRIAGE_CHOICES.includes(opts.triage)) {
    console.error(`winston init: --triage is one of ${TRIAGE_CHOICES.join(', ')}`)
    return 2
  }
  return opts.mode === 'join' ? join_(cwd, sit, opts.yes) : setup(cwd, sit, opts)
}

const INIT_FLAGS = { '--yes': false, '--public': false, '--mode': true, '--triage': true, '--board': true, '--integration': true, '--owner': true, '--repo': true }

/** Strict: an unknown flag, or a flag missing its value, is an error, never a guess. */
function initOptions(args) {
  const opts = {}
  for (let i = 0; i < args.length; i++) {
    const flag = args[i]
    if (!(flag in INIT_FLAGS)) throw new Error(`winston init: unknown argument ${flag}`)
    if (!INIT_FLAGS[flag]) opts[flag.slice(2)] = true
    else {
      const value = args[++i]
      if (value === undefined || value.startsWith('--')) throw new Error(`winston init: ${flag} needs a value`)
      opts[flag.slice(2)] = value
    }
  }
  return opts
}

const PERMISSION_FLAGS = { '--apply': false, '--add': true }

function permissionOptions(args) {
  const opts = { add: [] }
  for (let i = 0; i < args.length; i++) {
    const flag = args[i]
    if (!(flag in PERMISSION_FLAGS)) throw new Error(`winston permissions: unknown argument ${flag}`)
    if (!PERMISSION_FLAGS[flag]) opts.apply = true
    else {
      const value = args[++i]
      if (value === undefined || value.startsWith('--')) throw new Error(`winston permissions: ${flag} needs a value`)
      opts.add.push(value)
    }
  }
  return opts
}

function installCodexAgents(force) {
  const agents = codexSources()
  if (!agents.length) {
    console.log('No Codex agents in this plugin (codex/agents/*.toml).')
    return 0
  }
  let refused = 0
  for (const a of agents) {
    const want = readFileSync(a.src, 'utf8')
    const have = existsSync(a.dst) ? readFileSync(a.dst, 'utf8') : null
    if (have === want) {
      console.log(`same      ${a.dst}`)
      continue
    }
    if (have !== null && !force) {
      refused++
      console.log(`differs   ${a.dst} — not overwritten (rerun with --force to replace it)`)
      continue
    }
    mkdirSync(dirname(a.dst), { recursive: true })
    writeFileSync(a.dst, want)
    console.log(`${have === null ? 'installed' : 'replaced '} ${a.dst}`)
  }
  return refused ? 1 : 0
}

function config(cwd, json) {
  const layers = loadLayers(cwd)
  const merged = { ...layers.user.data, ...layers.repo.data }
  if (json) {
    console.log(JSON.stringify(merged, null, 2))
    return 0
  }
  for (const [name, l] of [['user', layers.user], ['repo', layers.repo]]) {
    console.log(`${name} layer: ${l.path ?? '(not in a git repository)'}${l.path ? (l.loaded ? '' : ' (not found)') : ''}`)
  }
  console.log(JSON.stringify(merged, null, 2))
  return 0
}

const USAGE = `usage: winston <command>   (in Claude Code, type it in the chat with ! in front: !winston doctor)

  doctor [--copy]                  the setup checklist: what is done, what needs you, and the next step
  init [--mode join|new|adopt]     plan the setup this folder needs; changes nothing
  init --mode <mode> --yes         apply that plan
  permissions [--apply]            list, or add, the rules that stop routine permission prompts
  config [--json]                  show Winston's settings for this folder
  install-codex-agents [--force]   copy Winston's agents into Codex
  title <words...>                 name this session`

function main(argv) {
  const [cmd, ...rest] = argv
  const cwd = process.cwd()
  try {
    switch (cmd) {
      case 'config': return config(cwd, rest.includes('--json'))
      case 'doctor':
        if (rest.some((a) => a !== '--copy')) throw new Error(`winston doctor: unknown argument ${rest.find((a) => a !== '--copy')}`)
        return doctor(cwd, rest.includes('--copy'))
      case 'init': return init(cwd, initOptions(rest))
      case 'permissions': return permissions(cwd, permissionOptions(rest))
      case 'install-codex-agents': return installCodexAgents(rest.includes('--force'))
      case 'title':
        if (!recordTitle(rest)) {
          console.error(`winston title: needs words and a Claude Code session (CLAUDE_CODE_SESSION_ID)`)
          return 1
        }
        return 0
      default:
        console.error(USAGE)
        return 2
    }
  } catch (e) {
    console.error(e.message)
    return 1
  }
}

if (import.meta.main) process.exitCode = main(process.argv.slice(2))
